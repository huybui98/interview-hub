=\"color:#24292E;--shiki-dark:#E1E4E8\">    List&#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">CollateralName</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">namesFor</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(Collection&#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">Long</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">loanIds</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">@</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">Service</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> LoanQueryService</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    private</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> final</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> LoanRepository loans;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    private</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> final</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> CollateralRepository collaterals;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    LoanQueryService</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(LoanRepository </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">loans</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, CollateralRepository </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">collaterals</span><span style=\"color:#2429