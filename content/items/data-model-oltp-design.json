>timestamptz</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NOT NULL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> DEFAULT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- Sổ cái kép: chỉ ghi thêm; tổng amount theo transfer_id = 0</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">CREATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> TABLE</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ledger_entry</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  id          </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">bigint</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> GENERATED</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ALWAYS</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> AS</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> IDENTITY</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> PRIMARY KEY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  transfer_id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">bigint</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NOT NULL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> REFERENCES</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> transfer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(id),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  account_id  </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">bigint</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NOT NULL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> REFERENCES</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> account(id),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  amount      </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">numeric</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">19</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">2</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">NOT NULL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> CHECK</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (amount </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">),   </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- âm: ghi nợ, dương: ghi có</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  created_at  </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">timestamptz</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NOT NULL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> DEFAULT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">CREATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> INDEX</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ix_ledger_account_time</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ON</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ledger_entry (account_id, created_at </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">DESC</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);   </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- sao kê</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- Danh mục xoá mềm: unique chỉ trên bản ghi chưa xoá</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">CREATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> TABLE</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> beneficiary</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">bigint</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> GENERATED</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ALWAYS</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> AS</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> IDENTITY</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> PRIMARY KEY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  customer_id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">bigint</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NOT NULL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> REFERENCES</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> customer(id),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  account_no </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">varchar</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">14</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">NOT NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  deleted_at </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">timestamptz</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">CREATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> UNIQUE INDEX</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ux_beneficiary_active</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ON</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> beneficiary (customer_id, account_no) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> deleted_at </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">IS</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NULL</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span></code></pre></div>"},{"key":"real","label":"Thực tế trong dự án của tôi","role":"personal","answer":true,"empty":false,"html":"<blockquote>\n<p><strong>Ngữ cảnh</strong> dựng từ các hệ thống dữ liệu, báo cáo trong dự án bạn đã tham gia (vai trò chính của bạn là Angular). <strong>Tình huống điển hình</strong> là tình huống hay gặp với dữ liệu ngân hàng, bảo hiểm do app biên soạn để luyện cách kể; số liệu là ví dụ minh hoạ. Chưa làm trực tiếp thì kể là đã tìm hiểu hoặc luyện, đừng nhận là đã vận hành.</p>\n</blockquote>\n<p><strong>Ngữ cảnh:</strong> dự án tra soát của ngân hàng A (khiếu nại, duyệt nhiều cấp, đơn vị chuyển tiếp) và hệ thống kế toán của công ty bảo hiểm D (chứng từ, bút toán) — tôi làm frontend và tham gia thảo luận mô hình dữ liệu với backend khi thiết kế màn hình.</p>\n<ul>\n<li><strong>Đã làm:</strong> đọc ERD và API để thiết kế form, danh sách; góp ý các trường thiếu cho màn hình (lý do từ chối, người duyệt từng cấp); thiết kế schema đầy đủ chưa làm trực tiếp ở dự án — đã tự thiết kế schema ngân hàng mẫu ở trên cho dự án luyện tập.</li>\n<li><strong>Kết quả:</strong> trình bày được thiết kế từ nghiệp vụ tới ràng buộc, không chỉ liệt kê bảng.</li>\n</ul>\n<p><strong>Tình huống điển hình:</strong> Thiết kế ban đầu cho hồ sơ khiếu nại lưu người duyệt cấp 1, 2, 3 thành ba cột; khi ngân hàng thêm cấp duyệt thứ tư phải đổi schema và sửa mọi truy vấn. Thiết kế lại: bảng hồ sơ, bảng bước duyệt (quan hệ 1-n) có người duyệt, kết quả, thời điểm; bảng đơn vị và bảng chuyển đơn vị. Số tiền lưu <code>numeric(18,2)</code>, ràng buộc khoá ngoại và check ở database, cột tạo/sửa/phiên bản cho mọi bảng.</p>\n<p><strong>Lưu ý khi kể:</strong> Thực thể chính và số bảng thật của dự án chỉ nêu khi bạn biết.</p>\n"},{"key":"followup","label":"Sẽ bị hỏi tiếp","role":"next","answer":true,"empty":false,"html":"<ul>\n<li><strong>Vì sao không lưu <code>customer_id</code> thẳng trong <code>account</code>?</strong> Vì quan hệ là n-n (đồng sở hữu); một cột chỉ mô tả được 1-n và sẽ phải sửa schema khi nghiệp vụ đồng sở hữu xuất hiện.</li>\n<li><strong>Số dư lưu riêng có mâu thuẫn chuẩn hoá không?</strong> Có — phi chuẩn hoá có chủ đích để đọc nhanh; bù lại phải cập nhật cùng transaction với bút toán và đối soát định kỳ — xem <a href=\"i/java-ent-ledger\">Thiết kế sổ cái (ledger) cho ví điện tử/ngân hàng số — bút toán kép, bất biến, số dư, tài khoản nóng, đa tiền tệ, đối soát</a>.</li>\n<li><strong>Đặt tên bảng số ít hay số nhiều?</strong> Chọn một và nhất quán; quan trọng hơn là tránh từ khoá (<code>user</code>, <code>order</code>, <code>group</code>) phải bọc ngoặc mọi nơi.</li>\n</ul>\n"},{"key":"traps","label":"Bẫy thường gặp","role":"caution","answer":true,"empty":false,"html":"<ul>\n<li><strong>Thiết kế từ danh từ, không từ mẫu truy cập</strong> — index sai, ràng buộc thiếu.</li>\n<li><strong>Cho phép sửa/xoá giao dịch tài chính</strong> — mất dấu vết kiểm toán; dùng bút toán đảo.</li>\n<li><strong>Xoá mềm với unique thường</strong> — không tạo lại được bản ghi đã xoá.</li>\n</ul>\n"},{"key":"sources","label":"Nguồn","role":"reference","answer":false,"empty":false,"html":"<ul>\n<li><a href=\"https://www.postgresql.org/docs/current/ddl.html\" target=\"_blank\" rel=\"noopener noreferrer\">PostgreSQL — Data Definition</a></li>\n<li><a href=\"https://www.postgresql.org/docs/current/indexes-partial.html\" target=\"_blank\" rel=\"noopener noreferrer\">PostgreSQL — Partial Indexes</a></li>\n<li><a href=\"https://martinfowler.com/eaaDev/AccountingNarrative.html\" target=\"_blank\" rel=\"noopener noreferrer\">Martin Fowler — Accounting Patterns</a></li>\n</ul>\n"}]}