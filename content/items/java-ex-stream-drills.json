--shiki-dark:#B392F0\">collect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toMap</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(Employee</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">::</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">dept, e </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> e,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">                BinaryOperator.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">maxBy</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">comparing</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(Employee</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">::</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">salary))));</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// 3. Lương trung bình theo phòng, sắp theo tên phòng</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Map&#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">BigDecimal</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> avgByDept </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> emps.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">stream</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        .</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">collect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42