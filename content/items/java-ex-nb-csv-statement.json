</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Txn</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(LocalDate date, String ref, BigDecimal amount, String description) {}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    record</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> LineError</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">int</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> lineNo, String line, String reason) {}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    record</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ParseResult</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(List</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">Txn</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> txns, List</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">LineError</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> errors) {}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    /** Đọc từng dòng (không nạp cả file vào RAM), dòng lỗi được ghi lại thay vì làm hỏng cả file. */</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    static</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ParseResult </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">parse</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(Path </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">file</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">throws</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> IOException {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        List&#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">Txn</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> txns </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ArrayList&#x3C;>();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        List&#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">LineError</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> errors </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ArrayList&#x3C;>();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        Set&#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> seenRefs </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> HashSet&#x3C;>();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        try</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (Stream&#x3C;</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">String</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> lines </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Files.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">lines</span><span style=\"color:#