dark:#B392F0\"> setup</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> res</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> axe.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">run</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(container);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    expect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(res.violations.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">filter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">v</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> v.impact </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'serious'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ||</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> v.impact </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'critical'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toEqual</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">([]);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  afterEach</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> TestBed.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">inject</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(HttpTestingController).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">verify</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">());</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"></span></code></pre></div>"},{"key":"real","label":"Thực tế trong dự án của tôi","role":"personal","answer":true,"empty":false,"html":"<blockquote>\n<p><strong>Ngữ cảnh</strong> dựng từ dự án thật trong CV của bạn — kiểm tra lại chi tiết trước khi dùng. <strong>Tình huống điển hình</strong> là tình huống hay gặp ở dự án Angular ngân hàng, bảo hiểm do app biên soạn để luyện cách kể; số liệu trong đó là ví dụ minh hoạ. Khi phỏng vấn, chỉ nhận là của mình phần bạn đã thật sự làm; phần còn lại kể là tình huống đã tìm hiểu hoặc tái hiện.</p>\n</blockquote>\n<p><strong>Ngữ cảnh:</strong> ngân hàng A — form gửi hồ sơ phê duyệt; công ty bảo hiểm C — form xác nhận báo giá. Cả hai cần chặn gửi trùng và hiện lỗi server đúng field.</p>\n<ul>\n<li><strong>Đã làm:</strong> viết test Jest theo hành vi người dùng: điền form, bấm gửi hai lần nhanh chỉ tạo một request (<code>HttpTestingController.expectOne</code>), lỗi 400 từ server gắn vào đúng ô, nút bị khoá khi đang gửi.</li>\n<li><strong>Kết quả:</strong> sửa logic gửi không sợ làm hỏng hành vi đã chốt với nghiệp vụ.</li>\n</ul>\n<p><strong>Tình huống điển hình:</strong> Bài tập: test form chuyển tiền bản đầu gọi trực tiếp method của component, refactor là vỡ. Viết lại theo hành vi người dùng: điền form qua DOM, kiểm tra thông báo lỗi khi bỏ trống, bấm gửi hai lần nhanh chỉ tạo một request, server trả lỗi số tài khoản thì lỗi hiện dưới đúng ô, ô lỗi có <code>aria-invalid</code>. Dùng <code>HttpTestingController</code> giả API. Refactor nội bộ không làm đổ test.</p>\n<p><strong>Lưu ý khi kể:</strong> Số test cho form và coverage của feature chỉ nêu khi đúng.</p>\n"},{"key":"followup","label":"Sẽ bị hỏi tiếp","role":"next","answer":true,"empty":false,"html":"<ul>\n<li><strong>Vì sao kiểm tra lỗi qua <code>aria-describedby</code> thay vì vị trí DOM?</strong> Vị trí DOM là chi tiết giao diện; <code>aria-describedby</code> là <strong>quan hệ có nghĩa</strong> — screen reader dùng nó để đọc lỗi khi focus ô — nên test kiểm tra đúng điều người dùng cần.</li>\n<li><strong>axe trong jsdom có tin cậy không?</strong> Bắt được nhiều lỗi cấu trúc (label, role, aria); không đo được tương phản màu (cần layout thật) — bổ sung bằng axe trong Playwright.</li>\n<li><strong>Nếu component dùng Signal Forms thì test có đổi không?</strong> Không — đó chính là mục tiêu: test chỉ dựa vào hành vi và DOM có nghĩa.</li>\n</ul>\n"},{"key":"traps","label":"Bẫy thường gặp","role":"caution","answer":true,"empty":false,"html":"<ul>\n<li><strong>Đọc <code>component.form.valid</code> trong test</strong> — gắn chặt vào cài đặt.</li>\n<li><strong><code>fireEvent.click</code> thay vì <code>userEvent</code></strong> — bỏ qua focus/blur và chuỗi sự kiện thật.</li>\n<li><strong>Không <code>verify()</code></strong> — request thừa (gửi trùng) lọt qua.</li>\n</ul>\n"},{"key":"sources","label":"Nguồn","role":"reference","answer":false,"empty":false,"html":"<ul>\n<li><a href=\"https://testing-library.com/docs/angular-testing-library/intro\" target=\"_blank\" rel=\"noopener noreferrer\">Testing Library — Angular</a></li>\n<li><a href=\"https://angular.dev/guide/testing/components-scenarios\" target=\"_blank\" rel=\"noopener noreferrer\">Angular — Testing components scenarios</a></li>\n</ul>\n"}]}