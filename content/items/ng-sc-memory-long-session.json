ber</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  };</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> serveCustomer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(page);               </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// làm ấm</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> before</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> heap</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">let</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 50</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">++</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> serveCustomer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(page);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> after</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> heap</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  expect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(after </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> before).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toBeLessThan</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">20</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1024</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1024</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">); </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// &#x3C; 20MB tăng sau 50 khách</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"></span></code></pre></div><h3>Tìm ai giữ</h3>\n<table>\n<thead>\n<tr>\n<th>Thấy trong snapshot</th>\n<th>Thường do</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><code>CustomerDetailComponent</code> × 50</td>\n<td>subscription tới Subject root, listener window</td>\n</tr>\n<tr>\n<td><code>Detached HTMLCanvasElement</code> × 50</td>\n<td>chart không destroy</td>\n</tr>\n<tr>\n<td><code>Detached HTMLIFrameElement</code></td>\n<td>thư viện in không gỡ iframe</td>\n</tr>\n<tr>\n<td>Mảng trong service tăng mãi</td>\n<td>cache/log không giới hạn</td>\n</tr>\n<tr>\n<td>Closure <code>(e) =&gt; ...</code> giữ component</td>\n<td><code>addEventListener</code> không <code>remove</code></td>\n</tr>\n</tbody>\n</table>\n<h3>Sửa điển hình</h3>\n<div class=\"ih-co