or:#22863A;--shiki-dark:#85E89D\">section</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> aria-live</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"polite\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  &#x3C;</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">h3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>Số dư&#x3C;/</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">h3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  @if (b?.value; as v) { &#x3C;</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">p</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> [class.opacity-60]</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"b!.status !== 'live'\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>{{ v.amount | vnd }}&#x3C;/</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">p</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  @switch (b?.status) {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    @case ('stale') { &#x3C;</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">small</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>Cập nhật lúc {{ b!.updatedAt | date: 'HH:mm' }}&#x3C;/</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">small</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    @case ('reconnecting') { &#x3C;</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">small</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>Đang kết nối lại…&#x3C;/</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">small</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    @case ('down') { &#x3C;</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">small</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>Không lấy được số dư.&#x3C;/</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">small</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> &#x3C;</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">button</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> type</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"button\"</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> (click)</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"monitor.retryBalance()\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>Thử lại&#x3C;/</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">button</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">> }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;/</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">section</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"line\"></span></code></pre></div>"},{"key":"real","label":"Thực tế trong dự án của tôi","role":"personal","answer":true,"empty":false,"html":"<blockquote>\n<p><strong>Ngữ cảnh</strong> dựng từ dự án thật trong CV của bạn — kiểm tra lại chi tiết trước khi dùng. <strong>Tình huống điển hình</strong> là tình huống hay gặp ở dự án Angular ngân hàng, bảo hiểm do app biên soạn để luyện cách kể; số liệu trong đó là ví dụ minh hoạ. Khi phỏng vấn, chỉ nhận là của mình phần bạn đã thật sự làm; phần còn lại kể là tình huống đã tìm hiểu hoặc tái hiện.</p>\n</blockquote>\n<p><strong>Ngữ cảnh:</strong> dự án dashboard realtime — dashboard nhiều nguồn dữ liệu (SignalR và API).</p>\n<ul>\n<li><strong>Đã làm:</strong> mỗi nguồn có <code>catchError</code> riêng, trả về trạng thái lỗi của widget đó thay vì làm hỏng cả <code>combineLatest</code>.</li>\n<li><strong>Kết quả:</strong> một widget lỗi, các widget khác vẫn chạy và hiện thông báo riêng.</li>\n</ul>\n<p><strong>Tình huống điển hình:</strong> Bài tập: dashboard gộp 3 luồng realtime bằng <code>combineLatest</code>; một luồng lỗi làm cả dashboard trắng. Bản sửa: mỗi luồng có <code>catchError</code> riêng trả về trạng thái lỗi của widget đó, kèm thời điểm dữ liệu cuối và nút thử lại; luồng lỗi tự kết nối lại có backoff. Hai widget kia vẫn cập nhật, người dùng biết rõ widget nào đang hiển thị dữ liệu cũ.</p>\n<p><strong>Lưu ý khi kể:</strong> Số widget và cách hiện lỗi thật chỉ nêu khi đúng.</p>\n"},{"key":"followup","label":"Sẽ bị hỏi tiếp","role":"next","answer":true,"empty":false,"html":"<ul>\n<li><strong>Vì sao <code>scan</code> mà không chỉ <code>map</code>?</strong> Cần nhớ <strong>giá trị cuối cùng hợp lệ</strong> qua các sự kiện lỗi; <code>scan</code> giữ state tích luỹ giữa các sự kiện.</li>\n<li><strong>Test hàm <code>resilient</code> thế nào?</strong> Marble test hoặc fake timer: nguồn giả lỗi 2 lần rồi thành công, kiểm tra chuỗi trạng thái <code>reconnecting → reconnecting → live</code> và giá trị cuối được giữ.</li>\n<li><strong>Có nên báo cả lỗi lên giám sát?</strong> Có — mỗi lần chuyển sang <code>down</code> gửi một sự kiện kèm tên nguồn; <code>reconnecting</code> thì chỉ đếm (metric), tránh dội log.</li>\n</ul>\n"},{"key":"traps","label":"Bẫy thường gặp","role":"caution","answer":true,"empty":false,"html":"<ul>\n<li><strong><code>combineLatest</code> cho các nguồn độc lập</strong> — một lỗi kéo sập tất cả.</li>\n<li><strong>Ẩn dữ liệu cũ khi lỗi</strong> — người dùng mất thông tin; giữ lại kèm nhãn thời điểm.</li>\n<li><strong>Retry vô hạn không backoff</strong> — dội server khi nó đang gặp sự cố.</li>\n</ul>\n"},{"key":"sources","label":"Nguồn","role":"reference","answer":false,"empty":false,"html":"<ul>\n<li><a href=\"https://rxjs.dev/api/index/function/catchError\" target=\"_blank\" rel=\"noopener noreferrer\">RxJS — catchError</a></li>\n<li><a href=\"https://rxjs.dev/api/index/function/retry\" target=\"_blank\" rel=\"noopener noreferrer\">RxJS — retry</a></li>\n</ul>\n"}]}