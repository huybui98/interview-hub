-shiki-dark:#E1E4E8\">    ref </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.host.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">createComponent</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(component, { injector });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> dialogRef;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Component trong dialog</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ConfirmTransfer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  protected</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> data</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> inject</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">DIALOG_DATA</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> TransferDraft</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  private</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> ref</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> inject</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">DialogRef</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>>(DialogRef);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  protected</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ok</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.ref.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">close</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">); }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span></code></pre></div><h3>Element injector hay environment injector</h3>\n<table>\n<thead>\n<tr>\n<th>Cần</th>\n<th>Dùng</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Dữ liệu, <code>DialogRef</code> cho một component</td>\n<td><code>Injector.create</code> (con của injector vị trí)</td>\n</tr>\n<tr>\n<td>Một nhóm service có vòng đời riêng (plugin, widget tải lười)</td>\n<td><code>createEnvironmentInjector(providers, parentEnvInjector)</code> + option <code>environmentInjector</code></td>\n</tr>\n<tr>\n<td>Component gắn ngoài cây Angular</td>\n<td><code>createComponent(Comp, { environmentInjector, hostElement })</code> từ <code>@angular/core</code></td>\n</tr>\n</tbody>\n</table>\n<h3>Dọn dẹp</h3>\n<p>Injector tạo bằng <code>Injector.create</code> sống theo component; <code>EnvironmentInjector</code> tự tạo phải gọi <code>destroy()</code> khi không dùng nữa, nếu không service bên trong (và subscription của chúng) sống mãi.</p>\n"},{"key":"real","label":"Thực tế trong dự án của tôi","role":"personal","answer":true,"empty":false,"html":"<blockquote>\n<p><strong>Ngữ cảnh</strong> dựng từ dự án thật trong CV của bạn — kiểm tra lại chi tiết trước khi dùng. <strong>Tình huống điển hình</strong> là tình huống hay gặp ở dự án Angular ngân hàng, bảo hiểm do app biên soạn để luyện cách kể; số liệu trong đó là ví dụ minh hoạ. Khi phỏng vấn, chỉ nhận là của mình phần bạn đã thật sự làm; phần còn lại kể là tình huống đã tìm hiểu hoặc tái hiện.</p>\n</blockquote>\n<p><strong>Ngữ cảnh:</strong> ngân hàng A — dialog xác nhận, dialog chi tiết tài sản được mở động và cần dữ liệu đầu vào.</p>\n<ul>\n<li><strong>Đã làm:</strong> truyền dữ liệu qua token dữ liệu của dialog (<code>MAT_DIALOG_DATA</code> hoặc token riêng) thay vì set field sau khi tạo; khi tự tạo component bằng <code>ViewContainerRef.createComponent</code> thì truyền <code>injector</code> con có provider riêng.</li>\n<li><strong>Kết quả:</strong> component dialog test được như component thường, không phụ thuộc người mở.</li>\n</ul>\n<p><strong>Tình huống điển hình:</strong> Dialog chi tiết tài sản được tạo động rồi gán dữ liệu bằng <code>componentRef.instance.data = ...</code> sau khi tạo; trong <code>ngOnInit</code> dữ liệu vẫn rỗng, đội phải thêm <code>setTimeout</code>. Sửa: truyền dữ liệu qua token dữ liệu của dialog trong injector riêng khi tạo, hoặc dùng <code>setInput</code> trước khi gắn vào view; service chỉ dùng trong dialog cung cấp ở injector đó. Bỏ được <code>setTimeout</code>, dữ liệu có ngay từ <code>ngOnInit</code>.</p>\n<p><strong>Lưu ý khi kể:</strong> Thư viện dialog và dialog cụ thể chỉ nêu khi đúng.</p>\n"},{"key":"followup","label":"Sẽ bị hỏi tiếp","role":"next","answer":true,"empty":false,"html":"<ul>\n<li><strong>Vì sao không truyền dữ liệu bằng input thay vì DI?</strong> Được — từ v20, <code>inputBinding()</code> cho truyền input khi tạo. DI hợp khi dữ liệu cần ở <strong>nhiều component</strong> bên trong dialog hoặc cần cả <code>DialogRef</code> để đóng.</li>\n<li><strong>Component động inject service được provide ở component cha khác (không phải nơi tạo) được không?</strong> Không — nó chỉ thấy chuỗi injector từ vị trí tạo. Muốn thì truyền injector đó làm <code>parent</code>.</li>\n<li><strong>CDK Dialog có cách làm tương tự không?</strong> Có — <code>Dialog.open(Comp, { data, injector })</code>; nên dùng CDK thay vì tự viết để có sẵn focus trap, backdrop, a11y.</li>\n</ul>\n"},{"key":"traps","label":"Bẫy thường gặp","role":"caution","answer":true,"empty":false,"html":"<ul>\n<li><strong>Dùng <code>ComponentFactoryResolver</code></strong> — API cũ đã deprecated.</li>\n<li><strong>Tạo <code>EnvironmentInjector</code> mà không <code>destroy()</code></strong> — rò service.</li>\n<li><strong>Truyền dữ liệu qua service root dùng chung</strong> — mở hai dialog là dữ liệu đè nhau.</li>\n</ul>\n"},{"key":"sources","label":"Nguồn","role":"reference","answer":false,"empty":false,"html":"<ul>\n<li><a href=\"https://angular.dev/guide/components/programmatic-rendering\" target=\"_blank\" rel=\"noopener noreferrer\">Angular — Programmatic rendering</a></li>\n<li><a href=\"https://angular.dev/guide/di/hierarchical-dependency-injection\" target=\"_blank\" rel=\"noopener noreferrer\">Angular — Hierarchical injectors</a></li>\n</ul>\n"}]}