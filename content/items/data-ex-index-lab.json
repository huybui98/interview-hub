tyle=\"color:#24292E;--shiki-dark:#E1E4E8\">;   </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- partial index cho phần hiếm</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">EXPLAIN </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> txn </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> status</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'DECLINED'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> AND</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> created_at </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> interval </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'1 day'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">CREATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> INDEX</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ix_branch</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ON</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> txn (branch_code);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">EXPLAIN </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> txn </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> account_id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 4242</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> OR</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> branch_code </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'CN007'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;   </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- BitmapOr ghép hai index</span></span>\n<span class=\"line\"></span></code></pre></div><table>\n<thead>\n<tr>\n<th>Trường hợp</th>\n<th>Trước</th>\n<th>Sửa</th>\n<th>Sau</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Sao kê theo tài khoản</td>\n<td>Seq Scan, đọc toàn bảng</td>\n<td><code>(account_id, created_at DESC)</code></td>\n<td>Index Scan, vài trang</td>\n</tr>\n<tr>\n<td>Hàm trên cột ngày</td>\n<td>Seq Scan</td>\n<td>điều kiện khoảng</td>\n<td>Index/Bitmap Scan</td>\n</tr>\n<tr>\n<td>Ép kiểu cột</td>\n<td>Seq Scan</td>\n<td>so đúng kiểu</td>\n<td>Index Scan</td>\n</tr>\n<tr>\n<td><code>LIKE '%x%'</code></td>\n<td>Seq Scan</td>\n<td>trigram GIN</td>\n<td>Bitmap Index Scan</td>\n</tr>\n<tr>\n<td>Chọn lọc thấp</td>\n<td>Seq Scan (đúng)</td>\n<td>partial index cho phần hiếm</td>\n<td>Index Scan trên phần hiếm</td>\n</tr>\n</tbody>\n</table>\n"},{"key":"real","label":"Thực tế trong dự án của tôi","role":"personal","answer":true,"empty":false,"html":"<blockquote>\n<p><strong>Ngữ cảnh</strong> dựng từ các hệ thống dữ liệu, báo cáo trong dự án bạn đã tham gia (vai trò chính của bạn là Angular). <strong>Tình huống điển hình</strong> là tình huống hay gặp với dữ liệu ngân hàng, bảo hiểm do app biên soạn để luyện cách kể; số liệu là ví dụ minh hoạ. Chưa làm trực tiếp thì kể là đã tìm hiểu hoặc luyện, đừng nhận là đã vận hành.</p>\n</blockquote>\n<p><strong>Ngữ cảnh:</strong> bài luyện cá nhân; liên hệ với các màn danh sách và sao kê có lọc theo tài khoản, khoảng ngày ở dự án tra soát của ngân hàng A và app doanh nghiệp của ngân hàng B.</p>\n<ul>\n<li><strong>Đã làm:</strong> chạy đủ lab trên PostgreSQL 18 bằng Docker, ghi bảng số đo trước/sau.</li>\n<li><strong>Kết quả:</strong> trả lời câu hỏi index bằng số liệu tự đo thay vì lý thuyết.</li>\n</ul>\n<p><strong>Tình huống điển hình:</strong> Lab trên bảng 5 triệu giao dịch: truy vấn lọc theo tài khoản và khoảng ngày chạy Seq Scan khoảng 900 ms, đọc hơn 60.000 trang. Thêm index <code>(account_id, txn_date)</code> còn khoảng 0,3 ms với vài trang; đảo thứ tự cột thành <code>(txn_date, account_id)</code> thì truy vấn theo tài khoản chậm lại rõ. Tự gây index bị bỏ qua bằng cách bọc cột trong hàm và so sánh khác kiểu, rồi sửa lại; số trên là ví dụ, tuỳ máy.</p>\n<p><strong>Lưu ý khi kể:</strong> Thay bằng số đo thật (ms, số trang) của từng bước khi bạn đã chạy lab.</p>\n"},{"key":"followup","label":"Sẽ bị hỏi tiếp","role":"next","answer":true,"empty":false,"html":"<ul>\n<li><strong>Vì sao chạy <code>EXPLAIN ANALYZE</code> 2–3 lần?</strong> Lần đầu đọc từ đĩa, các lần sau từ bộ nhớ đệm — so sánh công bằng phải cùng trạng thái; <code>BUFFERS</code> cho thấy rõ điều đó.</li>\n<li><strong><code>EXPLAIN ANALYZE</code> trên câu <code>UPDATE</code> có an toàn không?</strong> Không — nó <strong>thực thi</strong> câu lệnh; bọc trong <code>BEGIN ... ROLLBACK</code>.</li>\n<li><strong>Skip scan của PostgreSQL 18 thay đổi gì ở bước (2b)?</strong> Index thiếu điều kiện ở cột đầu có thể vẫn được dùng nếu cột đầu ít giá trị; với <code>created_at</code> nhiều giá trị thì không giúp — vẫn phải chọn đúng thứ tự.</li>\n</ul>\n"},{"key":"traps","label":"Bẫy thường gặp","role":"caution","answer":true,"empty":false,"html":"<ul>\n<li><strong>Đo một lần rồi kết luận</strong> — kết quả bị chi phối bởi bộ nhớ đệm.</li>\n<li><strong>Quên <code>ANALYZE</code> sau khi nạp dữ liệu</strong> — optimizer chọn plan theo thống kê sai.</li>\n<li><strong>Coi mọi <code>Seq Scan</code> là lỗi</strong> — với truy vấn lấy phần lớn bảng, đó là lựa chọn đúng.</li>\n</ul>\n"},{"key":"sources","label":"Nguồn","role":"reference","answer":false,"empty":false,"html":"<ul>\n<li><a href=\"https://www.postgresql.org/docs/current/using-explain.html\" target=\"_blank\" rel=\"noopener noreferrer\">PostgreSQL — Using EXPLAIN</a></li>\n<li><a href=\"https://use-the-index-luke.com/\" target=\"_blank\" rel=\"noopener noreferrer\">Use The Index, Luke</a></li>\n<li><a href=\"https://explain.dalibo.com/\" target=\"_blank\" rel=\"noopener noreferrer\">explain.dalibo.com</a></li>\n</ul>\n"}]}