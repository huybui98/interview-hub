an><span style=\"color:#D73A49;--shiki-dark:#F97583\"> INDEX</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ix_acc_time;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">CREATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> INDEX</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ix_time_acc</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ON</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> txn (created_at, account_id);</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- chạy lại EXPLAIN, so số trang; sau đó quay về index đúng, thêm INCLUDE để có index-only scan</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">DROP</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> INDEX</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ix_time_acc;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">CREATE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> INDEX</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ix_acc_time</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ON</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> txn (account_id, created_at </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">DESC</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">INCLUDE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (amount);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">VACUUM txn;                                   </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- cập nhật visibility map</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- (3) Năm trường hợp</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">CREATE