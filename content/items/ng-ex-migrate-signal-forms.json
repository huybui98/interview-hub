an class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  await</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> render</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(AddBeneficiary, { providers: [{ provide: BeneficiaryApi, useValue: fakeApi }] });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> userEvent.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">type</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(screen.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getByLabelText</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Số tài khoản'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">), </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'0123456789'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> userEvent.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">click</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(screen.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getByLabelText</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Lưu làm mẫu'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  expect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(screen.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getByText</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Nhập tên gợi nhớ để lưu làm mẫu'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toBeTruthy</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  expect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(screen.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getByRole</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'button'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, { name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Lưu'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> })).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toHaveProperty</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'disabled'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"></span></code></pre></div>"},{"key":"real","label":"Thực tế trong dự án của tôi","role":"personal","answer":true,"empty":false,"html":"<blockquote>\n<p><strong>Ngữ cảnh</strong> dựng từ dự án thật trong CV của bạn — kiểm tra lại chi tiết trước khi dùng. <strong>Tình huống điển hình</strong> là tình huống hay gặp ở dự án Angular ngân hàng, bảo hiểm do app biên soạn để luyện cách kể; số liệu trong đó là ví dụ minh hoạ. Khi phỏng vấn, chỉ nhận là của mình phần bạn đã thật sự làm; phần còn lại kể là tình huống đã tìm hiểu hoặc tái hiện.</p>\n</blockquote>\n<p><strong>Ngữ cảnh:</strong> các dự án công ty đều dùng Reactive Forms (công ty bảo hiểm C Angular 21, hệ thống kế toán của công ty bảo hiểm D Angular 20, ngân hàng A Angular 16). Signal Forms chỉ stable từ v22, nên chưa dùng ở đâu trong số đó.</p>\n<ul>\n<li><strong>Đã làm:</strong> làm bài tập chuyển một form nhỏ sang Signal Forms trên một demo Angular 22 riêng, giữ test hành vi cũ để chứng minh không đổi.</li>\n<li><strong>Kết quả:</strong> biết chỗ dễ (validation đơn) và chỗ khó (FormArray thành viên, CVA tự viết như ô nhập tiền) trước khi đề xuất thử ở dự án thật khi lên v22.</li>\n</ul>\n<p><strong>Tình huống điển hình:</strong> Bài tập: form thêm người thụ hưởng dùng Reactive Forms có <code>valueChanges</code> chéo giữa ngân hàng và chi nhánh, dễ lặp vô hạn. Chuyển sang Signal Forms: model là signal nguồn sự thật, schema khai báo validator và điều kiện chi nhánh bắt buộc khi chọn ngân hàng, lỗi từ server gắn vào đúng field khi submit. Code giảm khoảng một phần ba và hết vòng lặp <code>valueChanges</code>.</p>\n<p><strong>Lưu ý khi kể:</strong> Gắn link demo nếu đã làm; form nào ở dự án thật bạn sẽ thử đầu tiên chỉ nêu khi đã cân nhắc thật.</p>\n"},{"key":"followup","label":"Sẽ bị hỏi tiếp","role":"next","answer":true,"empty":false,"html":"<ul>\n<li><strong>Có nên migrate hàng trăm form cùng lúc?</strong> Không — chuyển khi có lý do sửa lớn; ưu tiên form có logic điều kiện phức tạp vì lợi ích lớn nhất.</li>\n<li><strong>Component trong design system nên viết lại theo API mới không?</strong> Dần dần theo <code>FormValueControl</code> (dùng <code>model()</code>), để dùng được cho cả Signal Forms; giai đoạn chuyển tiếp CVA vẫn chạy.</li>\n<li><strong>Lỗi server gắn vào đúng field (ví dụ &quot;số tài khoản không tồn tại&quot;) thế nào?</strong> Action trả về lỗi gắn với field tương ứng thay vì lỗi cấp form; hoặc dùng <code>validateHttp</code> để kiểm tra trước khi submit.</li>\n</ul>\n"},{"key":"traps","label":"Bẫy thường gặp","role":"caution","answer":true,"empty":false,"html":"<ul>\n<li><strong>Chuyển mà không có test hành vi</strong> — thay đổi thời điểm hiện lỗi hay kiểu dữ liệu gửi lên mà không ai biết.</li>\n<li><strong>Giữ thói quen <code>valueChanges</code> + <code>updateValueAndValidity</code></strong> — Signal Forms đã reactive, viết thêm là thừa và dễ lặp.</li>\n<li><strong>Quên <code>novalidate</code></strong> — validation của trình duyệt chen vào, thông báo lỗi trùng hoặc lệch.</li>\n</ul>\n"},{"key":"sources","label":"Nguồn","role":"reference","answer":false,"empty":false,"html":"<ul>\n<li><a href=\"https://angular.dev/guide/forms/signals/overview\" target=\"_blank\" rel=\"noopener noreferrer\">Angular — Signal Forms overview</a></li>\n<li><a href=\"https://timdeschryver.dev/blog/refactoring-a-form-to-a-signal-form\" target=\"_blank\" rel=\"noopener noreferrer\">Tim Deschryver — Refactoring a form to a Signal Form</a></li>\n<li><a href=\"https://timdeschryver.dev/blog/angular-signal-forms-keeps-improving\" target=\"_blank\" rel=\"noopener noreferrer\">Tim Deschryver — Angular Signal Forms keeps improving</a></li>\n<li><a href=\"https://testing-library.com/docs/angular-testing-library/intro/\" target=\"_blank\" rel=\"noopener noreferrer\">Testing Library — Angular Testing Library</a></li>\n</ul>\n"}]}