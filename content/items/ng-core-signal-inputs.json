rk:#E1E4E8\"> input.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">required</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>();                                </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// bắt buộc</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> disabled</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> input</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, { transform: booleanAttribute });      </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// &#x3C;app-amount-input disabled></span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> currency</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> input</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'VND'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, { alias: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'ccy'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });                     </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// [ccy]=\"'USD'\"</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> touched</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> output</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">void</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  protected</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> display</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> computed</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">value</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()?.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toLocaleString</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'vi-VN'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> ''</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  protected</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> onInput</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">e</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Event</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> n</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((e.target </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> HTMLInputElement</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).value.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">replace</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">\\D</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">g</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">''</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.value.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">min</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(n, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">max</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span></code></pre></div><div class=\"ih-code\" data-lang=\"html\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">app-amount-input</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> [(value)]</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"amount\"</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> [max]</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"limit()\"</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> disabled</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> (touched)</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"markTouched()\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> /></span></span>\n<span class=\"line\"></span></code></pre></div><h3>Dẫn xuất state từ input</h3>\n<div class=\"ih-code\" data-lang=\"ts\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">readonly account </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> input.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">required</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Account</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>();</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// thay cho ngOnChanges: tự tính lại khi account đổi</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">protected readonly isOverdrawn </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> computed</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">account</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">().balance </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span></code></pre></div><p>Cần state <strong>cục bộ khởi tạo từ input nhưng sửa được</strong> (form chỉnh sửa) thì dùng <code>linkedSignal(() =&gt; this.account().name)</code>, không gán ngược vào input.</p>\n<h3>Migration</h3>\n<ul>\n<li><code>ng g @angular/core:signal-inputs</code>, <code>ng g @angular/core:outputs</code>, <code>ng g @angular/core:signal-queries</code> — chạy theo <code>--path</code>.</li>\n<li>Schematic bỏ qua chỗ không an toàn (input bị gán lại trong component); xem báo cáo để sửa tay.</li>\n<li>Template không đổi gì ngoài việc đọc <code>value()</code> thay vì <code>value</code> bên trong class.</li>\n</ul>\n"},{"key":"real","label":"Thực tế trong dự án của tôi","role":"personal","answer":true,"empty":false,"html":"<blockquote>\n<p><strong>Ngữ cảnh</strong> dựng từ dự án thật trong CV của bạn — kiểm tra lại chi tiết trước khi dùng. <strong>Tình huống điển hình</strong> là tình huống hay gặp ở dự án Angular ngân hàng, bảo hiểm do app biên soạn để luyện cách kể; số liệu trong đó là ví dụ minh hoạ. Khi phỏng vấn, chỉ nhận là của mình phần bạn đã thật sự làm; phần còn lại kể là tình huống đã tìm hiểu hoặc tái hiện.</p>\n</blockquote>\n<p><strong>Ngữ cảnh:</strong> công ty bảo hiểm C (Angular 21) — component dùng <code>input()</code>, <code>input.required()</code>, <code>model()</code> thay cho <code>@Input/@Output</code>.</p>\n<ul>\n<li><strong>Đã làm:</strong> dùng <code>computed</code> thay <code>ngOnChanges</code> để tính lại khi input đổi; <code>transform</code> cho input boolean/số; <code>model()</code> cho component chọn ngày dùng hai chiều.</li>\n<li><strong>Kết quả:</strong> gần như không còn <code>ngOnChanges</code>, lỗi input <code>undefined</code> bắt được lúc build.</li>\n</ul>\n<p><strong>Tình huống điển hình:</strong> Component hiển thị khoản vay dùng <code>ngOnChanges</code> để tính lại kỳ trả góp khi input đổi; quên kiểm tra <code>changes.amount</code> nên tính sai khi chỉ lãi suất đổi. Chuyển sang <code>input.required()</code> và <code>computed()</code> dựa trên cả hai input: tính lại đúng khi bất kỳ input nào đổi, không cần so <code>SimpleChanges</code>. Ô chọn kỳ hạn dùng <code>model()</code> cho binding hai chiều; input boolean dùng <code>transform: booleanAttribute</code>.</p>\n<p><strong>Lưu ý khi kể:</strong> Số component đã chuyển và lỗi biến mất chỉ nêu khi đúng.</p>\n"},{"key":"followup","label":"Sẽ bị hỏi tiếp","role":"next","answer":true,"empty":false,"html":"<ul>\n<li><strong><code>model()</code> khác <code>input()</code> + <code>output()</code> ở đâu?</strong> <code>model()</code> gộp cả hai: con gọi <code>.set()</code> thì phát sự kiện <code>valueChange</code> cho cha. Nó không phải là cách để con tuỳ tiện sửa mọi dữ liệu của cha — chỉ dùng cho giá trị thực sự hai chiều như control.</li>\n<li><strong>Có subscribe được <code>output()</code> từ code không?</strong> Có: <code>ref.instance.touched.subscribe(...)</code> trả về subscription; và <code>outputFromObservable</code>/<code>outputToObservable</code> để nối với RxJS.</li>\n<li><strong>Từ v22, <code>model</code> và <code>output</code> cùng tên thì sao?</strong> Compiler báo lỗi; <code>ng update</code> có migration chuyển <code>model</code> đó thành <code>input</code> + <code>linkedSignal</code>.</li>\n</ul>\n"},{"key":"traps","label":"Bẫy thường gặp","role":"caution","answer":true,"empty":false,"html":"<ul>\n<li><strong>Gán <code>this.myInput.set(...)</code></strong> — <code>input()</code> không có <code>set</code>; cần ghi thì là <code>model()</code> hoặc state riêng bằng <code>linkedSignal</code>.</li>\n<li><strong>Đọc <code>input.required()</code> trong constructor</strong> — giá trị chưa có, ném lỗi.</li>\n<li><strong>Dùng <code>effect</code> để copy input sang signal khác</strong> — dùng <code>computed</code> hoặc <code>linkedSignal</code>; effect chỉ cho side effect ra ngoài.</li>\n</ul>\n"},{"key":"sources","label":"Nguồn","role":"reference","answer":false,"empty":false,"html":"<ul>\n<li><a href=\"https://angular.dev/guide/signals/inputs\" target=\"_blank\" rel=\"noopener noreferrer\">Angular — Signal inputs</a></li>\n<li><a href=\"https://angular.dev/guide/signals/model\" target=\"_blank\" rel=\"noopener noreferrer\">Angular — Model inputs</a></li>\n<li><a href=\"https://angular.dev/reference/migrations/signal-inputs\" target=\"_blank\" rel=\"noopener noreferrer\">Angular — Signal input migration</a></li>\n</ul>\n"}]}