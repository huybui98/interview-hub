-dark:#9ECBFF\">\"</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">%s</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> %s</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, url, detail)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">        else</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            failed </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">+=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            log.error(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">%s</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> %s</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, url, detail)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    return</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> failed </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">else</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">if</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> __name__</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ==</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"__main__\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    sys.exit(main())</span></span>\n<span class=\"line\"></span></code></pre></div><p>Gọi lệnh ngoài đúng cách, ví dụ chờ rollout xong:</p>\n<div class=\"ih-code\" data-lang=\"python\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">import</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> subprocess</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">subprocess.run(</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"kubectl\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"rollout\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"status\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"deployment/api\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"-n\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"sit\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"--timeout=120s\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">],</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    check</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">True</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#E36209;--shiki-dark:#FFAB70\">    timeout</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">150</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"></span></code></pre></div><p>Script health đã chạy thử với Python 3.14 trên máy lab: một URL tốt trả exit 0; thêm một cổng không có ai nghe hoặc một đường dẫn 404 trả exit 1; thiếu tham số trả exit 2. Code không dùng cú pháp mới hơn Python 3.9.</p>\n"},{"key":"real","label":"Thực tế trong dự án của tôi","role":"personal","answer":true,"empty":false,"html":"<blockquote>\n<p><strong>Ngữ cảnh</strong> dựng từ phần hạ tầng của các dự án bạn đã tham gia (vai trò chính của bạn là Angular; hạ tầng thường do team nền tảng sở hữu). <strong>Tình huống điển hình</strong> là tình huống hay gặp khi vận hành hệ thống ngân hàng, bảo hiểm do app biên soạn để luyện cách kể; số liệu là ví dụ minh hoạ. Chỉ nhận là của mình phần bạn đã thật sự làm; phần khác kể là đã tìm hiểu hoặc tái hiện trong lab.</p>\n</blockquote>\n<p><strong>Ngữ cảnh:</strong> chưa viết script vận hành bằng Python ở dự án; kinh nghiệm script gần nhất là script npm và Node trong build Frontend.</p>\n<ul>\n<li><strong>Đã làm:</strong> chưa viết script vận hành bằng Python ở dự án; bài lab tương ứng là script gọi GitLab API liệt kê pipeline thất bại, xuất CSV (giai đoạn 3).</li>\n<li><strong>Kết quả:</strong> có script mẫu với timeout, exit code đúng để dùng lại.</li>\n</ul>\n<p><strong>Tình huống điển hình:</strong> Script Bash kiểm tra 12 service sau mỗi lần deploy báo thành công dù 2 service trả 500, vì <code>curl</code> không có <code>--fail</code> và kết quả bị nuốt trong pipe. Đội viết lại bằng Python dùng thư viện chuẩn: timeout 5 giây mỗi lời gọi, kiểm tra cả mã HTTP lẫn trường <code>status</code>, chạy song song, trả exit code 1 khi có service lỗi. Pipeline dừng đúng lúc; thời gian kiểm tra từ 40 giây còn 6 giây.</p>\n"},{"key":"followup","label":"Sẽ bị hỏi tiếp","role":"next","answer":true,"empty":false,"html":"<ul>\n<li><strong>Vì sao <code>shell=True</code> nguy hiểm?</strong> Chuỗi được shell diễn giải: tên file hoặc tham số chứa <code>; rm -rf ...</code> sẽ chạy thành lệnh. Dùng danh sách tham số thì mỗi phần tử chỉ là dữ liệu.</li>\n<li><strong>Script cần thư viện ngoài mà server không ra Internet?</strong> Tải qua kho nội bộ làm proxy cho PyPI, ghim phiên bản; hoặc đóng gói sẵn wheel — xem <a href=\"i/ops-cicd-artifact-repo-airgap\">Build trong mạng ngân hàng không ra Internet — kho artifact (Nexus, Artifactory, Harbor) làm proxy cho Maven/npm/Docker, cấu hình mirror, phê duyệt thư viện mới, và vì sao 'npm install chạy ở nhà nhưng không chạy ở công ty'</a>.</li>\n<li><strong>Khi nào dùng Ansible thay vì script?</strong> Khi cấu hình nhiều máy theo trạng thái mong muốn và cần chạy lại an toàn nhiều lần — xem <a href=\"i/ops-iac-ansible\">Ansible dùng để làm gì khi đã có Terraform — configuration management, idempotent, inventory, role, Ansible Vault; và vị trí của nó trong thời container</a>.</li>\n<li><strong>Viết test cho script vận hành thế nào?</strong> Tách phần xử lý dữ liệu thành hàm thuần để test bằng <code>pytest</code>; phần gọi mạng giả lập bằng server cục bộ như trong ví dụ.</li>\n</ul>\n"},{"key":"traps","label":"Bẫy thường gặp","role":"caution","answer":true,"empty":false,"html":"<ul>\n<li><strong>Không đặt timeout cho HTTP</strong> — một service treo làm job CI treo tới khi runner huỷ.</li>\n<li><strong><code>except Exception: pass</code></strong> — nuốt mọi lỗi, script vẫn trả exit 0 và pipeline &quot;xanh&quot;.</li>\n<li><strong><code>subprocess.run</code> không có <code>check=True</code></strong> — lệnh lỗi bị bỏ qua giống hệt Bash thiếu <code>set -e</code>.</li>\n<li><strong>Viết bằng cú pháp Python mới nhất</strong> rồi chạy trên server RHEL với Python 3.9 — lỗi cú pháp ngay khi chạy.</li>\n</ul>\n"},{"key":"sources","label":"Nguồn","role":"reference","answer":false,"empty":false,"html":"<ul>\n<li><a href=\"https://docs.python.org/3/library/subprocess.html\" target=\"_blank\" rel=\"noopener noreferrer\">Python — subprocess</a></li>\n<li><a href=\"https://docs.python.org/3/library/urllib.request.html\" target=\"_blank\" rel=\"noopener noreferrer\">Python — urllib.request</a></li>\n<li><a href=\"https://docs.python.org/3/library/argparse.html\" target=\"_blank\" rel=\"noopener noreferrer\">Python — argparse</a></li>\n</ul>\n"}]}