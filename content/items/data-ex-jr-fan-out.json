n><span style=\"color:#D73A49;--shiki-dark:#F97583\">ON</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> true</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">LEFT JOIN</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> LATERAL (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> count</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> so_lan_rut, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">sum</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(amount) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> tong_rut</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">                   FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> withdrawals </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> customer_id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> c</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">id</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) w </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">ON</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> true</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">ORDER BY</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> c</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">id</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- ❌ \"Chữa\" bằng DISTINCT: An ra 300000 vì hai khoản 100000 bị gộp làm một</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> c</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">full_name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">sum</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">DISTINCT</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> d</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">amount</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> tong_nap_sai</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> customers2 c</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">LEFT JOIN</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> deposits d    </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">ON</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> d</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">customer_id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> c</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">id</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">LEFT JOIN</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> withdrawals w </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">ON</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> w</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">customer_id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> c</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">id</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">GROUP BY</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> c</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">id</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">c</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">full_name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span></code></pre></div>"},{"key":"real","label":"Thực tế trong dự án của tôi","role":"personal","answer":true,"empty":false,"html":"<blockquote>\n<p><strong>Ngữ cảnh</strong> dựng từ các hệ thống dữ liệu, báo cáo trong dự án bạn đã tham gia (vai trò chính của bạn là Angular). <strong>Tình huống điển hình</strong> là tình huống hay gặp với dữ liệu ngân hàng, bảo hiểm do app biên soạn để luyện cách kể; số liệu là ví dụ minh hoạ. Chưa làm trực tiếp thì kể là đã tìm hiểu hoặc luyện, đừng nhận là đã vận hành.</p>\n</blockquote>\n<p><strong>Ngữ cảnh:</strong> màn dashboard và báo cáo ở các dự án ngân hàng, kế toán hiển thị số liệu tổng hợp từ backend.</p>\n<ul>\n<li><strong>Đã làm:</strong> phía Frontend hiển thị số liệu; câu tổng hợp phía backend chưa viết trực tiếp — đã tái hiện và sửa fan-out trong bài này.</li>\n<li><strong>Kết quả:</strong> khi số liệu dashboard &quot;gấp đôi, gấp ba&quot; bất thường, biết nghi ngay JOIN nhiều bảng con.</li>\n</ul>\n<p><strong>Tình huống điển hình:</strong> Bài tập: báo cáo tổng tiền nạp và số lần rút mỗi khách ra số quá lớn: join khách với bảng nạp và bảng rút cùng lúc, khách có 3 lần nạp và 4 lần rút thành 12 dòng, tổng nạp bị nhân 4. Sửa bằng cách tổng hợp từng bảng con theo khách trước rồi mới join, hoặc dùng subquery tương quan; đối chiếu lại với tổng tính riêng từng bảng để chứng minh đúng.</p>\n"},{"key":"followup","label":"Sẽ bị hỏi tiếp","role":"next","answer":true,"empty":false,"html":"<ul>\n<li><strong>Ba cách sửa, cách nào nhanh nhất?</strong> Tính cho mọi khách: CTE tổng hợp trước (mỗi bảng quét một lần, hash aggregate). Tính cho vài khách: subquery hoặc LATERAL dùng index trên <code>customer_id</code>. Đo bằng <code>EXPLAIN ANALYZE</code> thay vì đoán.</li>\n<li><strong>Có cách nào phát hiện fan-out tự động không?</strong> Test so tổng của báo cáo với tổng tính riêng từ bảng nguồn; trong pipeline dữ liệu dùng kiểm tra &quot;tổng sau ≤ tổng trước&quot;.</li>\n<li><strong>Quan hệ 1-1 có bị fan-out không?</strong> Không, miễn đúng là 1-1 có <code>UNIQUE</code>; thiếu ràng buộc đó thì một dòng trùng là đủ để nhân đôi.</li>\n</ul>\n"},{"key":"traps","label":"Bẫy thường gặp","role":"caution","answer":true,"empty":false,"html":"<ul>\n<li><strong>JOIN nhiều bảng con ngang hàng rồi <code>SUM</code></strong> — kết quả nhân theo tích số dòng.</li>\n<li><strong>Dùng <code>DISTINCT</code> hoặc <code>sum(DISTINCT)</code> để &quot;chữa&quot;</strong> — đúng tình cờ, sai khi có giá trị trùng.</li>\n<li><strong>Quên <code>COALESCE</code> sau LEFT JOIN</strong> — khách không có giao dịch ra NULL thay vì 0.</li>\n</ul>\n"},{"key":"sources","label":"Nguồn","role":"reference","answer":false,"empty":false,"html":"<ul>\n<li><a href=\"https://www.postgresql.org/docs/current/queries-table-expressions.html\" target=\"_blank\" rel=\"noopener noreferrer\">PostgreSQL — Table Expressions (Joined Tables, LATERAL)</a></li>\n<li><a href=\"https://www.postgresql.org/docs/current/queries-with.html\" target=\"_blank\" rel=\"noopener noreferrer\">PostgreSQL — WITH Queries (CTE)</a></li>\n<li><a href=\"https://www.postgresql.org/docs/current/sql-expressions.html\" target=\"_blank\" rel=\"noopener noreferrer\">PostgreSQL — Scalar Subqueries</a></li>\n</ul>\n"}]}