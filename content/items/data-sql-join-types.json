olor:#005CC5;--shiki-dark:#79B8FF\"> b</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">city</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x3C;></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> a</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">city</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span></code></pre></div><h3>Semi-join và anti-join</h3>\n<div class=\"ih-code\" data-lang=\"sql\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- Có giao dịch tháng 11 (không nhân bản khách hàng)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> c.</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> customer c</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> EXISTS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> txn t </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> t</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">customer_id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> c</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> AND</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> t</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">txn_date</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> >=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> DATE</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '2026-11-01'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- Chưa từng giao dịch</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> c.</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">*</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> customer c</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NOT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> EXISTS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> txn t </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> t</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">customer_id</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> c</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">id</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- Bẫy: nếu txn.customer_id có một giá trị NULL, câu này trả RỖNG</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> *</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> customer </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">NOT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> IN</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> customer_id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> txn);</span></span>\n<span class=\"line\"></span></code></pre></div><p><code>LEFT JOIN ... WHERE t.customer_id IS NULL</code> cũng là anti-join đúng; optimizer hiện đại thường sinh cùng plan với <code>NOT EXISTS</code>.</p>\n<h3>UNION vs UNION ALL</h3>\n<div class=\"ih-code\" data-lang=\"sql\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ref, amount </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> txn_2026_10</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">UNION ALL</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ref, amount </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> txn_2026_11;   </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- không bỏ trùng, nhanh</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> phone </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> customer</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">UNION</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> phone </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> prospect;           </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- danh sách số điện thoại duy nhất</span></span>\n<span class=\"line\"></span></code></pre></div><p>Số cột và kiểu phải tương thích; tên cột lấy theo câu đầu tiên.</p>\n"},{"key":"real","label":"Thực tế trong dự án của tôi","role":"personal","answer":true,"empty":false,"html":"<blockquote>\n<p><strong>Ngữ cảnh</strong> dựng từ các hệ thống dữ liệu, báo cáo trong dự án bạn đã tham gia (vai trò chính của bạn là Angular). <strong>Tình huống điển hình</strong> là tình huống hay gặp với dữ liệu ngân hàng, bảo hiểm do app biên soạn để luyện cách kể; số liệu là ví dụ minh hoạ. Chưa làm trực tiếp thì kể là đã tìm hiểu hoặc luyện, đừng nhận là đã vận hành.</p>\n</blockquote>\n<p><strong>Ngữ cảnh:</strong> báo cáo cần cả đơn vị không có hồ sơ (LEFT JOIN).</p>\n<ul>\n<li><strong>Đã làm:</strong> luyện các loại join và semi-join.</li>\n<li><strong>Kết quả:</strong> trả lời có ví dụ.</li>\n</ul>\n<p><strong>Tình huống điển hình:</strong> Báo cáo số hồ sơ theo đơn vị bỏ mất các đơn vị không có hồ sơ nào vì dùng <code>INNER JOIN</code>; lãnh đạo tưởng các đơn vị đó không tồn tại. Sửa bằng <code>LEFT JOIN</code> từ bảng đơn vị. Ở báo cáo khác, đội dùng <code>EXISTS</code> để lấy khách có ít nhất một khoản vay (semi-join, không nhân dòng), <code>NOT EXISTS</code> cho khách chưa vay, và <code>UNION ALL</code> thay <code>UNION</code> khi ghép hai nguồn không trùng để bỏ bước sắp xếp khử trùng.</p>\n"},{"key":"followup","label":"Sẽ bị hỏi tiếp","role":"next","answer":true,"empty":false,"html":"<ul>\n<li><strong>JOIN làm tăng số dòng bất ngờ — vì sao?</strong> Khoá nối không duy nhất ở một phía (quan hệ 1-n hoặc n-n) — kiểm tra cardinality trước khi SUM, nếu không số liệu bị nhân lên.</li>\n<li><strong><code>INTERSECT</code> và <code>EXCEPT</code> dùng khi nào?</strong> Lấy phần chung/phần chênh giữa hai tập kết quả — tiện khi so sánh hai phiên bản bảng trong lúc migrate.</li>\n<li><strong>Hash join, merge join, nested loop khác nhau?</strong> Thuật toán vật lý optimizer chọn theo kích thước và index — xem bài đọc EXPLAIN.</li>\n</ul>\n"},{"key":"traps","label":"Bẫy thường gặp","role":"caution","answer":true,"empty":false,"html":"<ul>\n<li><strong><code>NOT IN</code> với cột có NULL</strong> — trả rỗng, báo cáo &quot;không có khách hàng nào chưa giao dịch&quot;.</li>\n<li><strong><code>UNION</code> khi không cần bỏ trùng</strong> — thêm bước sắp xếp/hash tốn kém.</li>\n<li><strong>JOIN để kiểm tra tồn tại</strong> — nhân bản dòng; dùng EXISTS.</li>\n</ul>\n"},{"key":"sources","label":"Nguồn","role":"reference","answer":false,"empty":false,"html":"<ul>\n<li><a href=\"https://www.postgresql.org/docs/current/queries-table-expressions.html#QUERIES-JOIN\" target=\"_blank\" rel=\"noopener noreferrer\">PostgreSQL — Table Expressions: Joined Tables</a></li>\n<li><a href=\"https://www.postgresql.org/docs/current/functions-subquery.html\" target=\"_blank\" rel=\"noopener noreferrer\">PostgreSQL — Subquery Expressions (EXISTS, NOT IN)</a></li>\n<li><a href=\"https://www.postgresql.org/docs/current/queries-union.html\" target=\"_blank\" rel=\"noopener noreferrer\">PostgreSQL — Combining Queries (UNION, INTERSECT, EXCEPT)</a></li>\n</ul>\n"}]}