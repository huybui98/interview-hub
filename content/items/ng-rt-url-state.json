i-dark:#9ECBFF\"> 'OUT'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'ALL'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> sort</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> input</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'date'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '-date'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'amount'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '-amount'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'-date'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> page</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> input</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, { </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">transform</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">v</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> unknown</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">max</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(v) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">||</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  protected</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> data</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> httpResource</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Page</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Txn</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>>(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    url: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/api/statement'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    params: { from: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> ''</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, to: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">to</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> ''</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, type: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">type</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(), sort: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">sort</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(), page: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">page</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span></code></pre></div><h3>Ghi lên URL</h3>\n<div class=\"ih-code\" data-lang=\"ts\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">private readonly router </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> inject</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(Router);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">protected </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">setFilter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(patch: Partial</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{ from: string; to: string; type: string }</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, opts: { replace?: boolean } </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {}) {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.router.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">navigate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">([], {</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    queryParams: { </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">patch, page: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },          </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// đổi filter -> về trang 1</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    queryParamsHandling: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'merge'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    replaceUrl: opts.replace </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">protected </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">goPage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(page: number) {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">  this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.router.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">navigate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">([], { queryParams: { page }, queryParamsHandling: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'merge'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }); </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// tạo lịch sử</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span></code></pre></div><h3>Khi nào <code>replaceUrl</code></h3>\n<table>\n<thead>\n<tr>\n<th>Thay đổi</th>\n<th>Lịch sử mới?</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Gõ ô tìm kiếm (đã debounce)</td>\n<td>không — <code>replaceUrl</code></td>\n</tr>\n<tr>\n<td>Chọn bộ lọc, áp dụng</td>\n<td>có</td>\n</tr>\n<tr>\n<td>Chuyển trang</td>\n<td>có</td>\n</tr>\n<tr>\n<td>Mở/đóng panel phụ</td>\n<td>tuỳ — thường không</td>\n</tr>\n</tbody>\n</table>\n<h3>Validate</h3>\n<p>Query param có thể là bất kỳ chuỗi nào: <code>?page=-5</code>, <code>?type=&lt;script&gt;</code>. Chuẩn hoá trong <code>transform</code> của input hoặc schema; giá trị lạ thì về mặc định — không đưa thẳng vào API hay hiển thị.</p>\n<h3>Giữ URL ngắn</h3>\n<p>Bỏ giá trị mặc định khỏi URL (<code>type=ALL</code> không cần ghi) bằng cách gán <code>null</code> trong <code>queryParams</code> — router xoá khoá đó.</p>\n"},{"key":"real","label":"Thực tế trong dự án của tôi","role":"personal","answer":true,"empty":false,"html":"<blockquote>\n<p><strong>Ngữ cảnh</strong> dựng từ dự án thật trong CV của bạn — kiểm tra lại chi tiết trước khi dùng. <strong>Tình huống điển hình</strong> là tình huống hay gặp ở dự án Angular ngân hàng, bảo hiểm do app biên soạn để luyện cách kể; số liệu trong đó là ví dụ minh hoạ. Khi phỏng vấn, chỉ nhận là của mình phần bạn đã thật sự làm; phần còn lại kể là tình huống đã tìm hiểu hoặc tái hiện.</p>\n</blockquote>\n<p><strong>Ngữ cảnh:</strong> ngân hàng A — màn tra cứu có nhiều bộ lọc (trạng thái, chi nhánh, khoảng ngày).</p>\n<ul>\n<li><strong>Đã làm:</strong> đồng bộ bộ lọc với query param, dùng <code>replaceUrl</code> khi gõ để không tạo lịch sử rác, đọc lại từ URL khi vào trang.</li>\n<li><strong>Kết quả:</strong> F5 và chia sẻ link giữ được bộ lọc.</li>\n</ul>\n<p><strong>Tình huống điển hình:</strong> Nhân viên gửi đồng nghiệp link danh sách hồ sơ quá hạn nhưng người nhận thấy danh sách khác vì bộ lọc chỉ nằm trong bộ nhớ. Đội đồng bộ bộ lọc, sắp xếp, trang với query param; khi gõ tìm kiếm dùng <code>replaceUrl</code> để không tạo hàng chục mục lịch sử; vào trang thì đọc lại từ URL. F5 và chia sẻ link giữ đúng bộ lọc; nút Back quay về trang trước thật sự.</p>\n<p><strong>Lưu ý khi kể:</strong> Màn đã làm và màn chưa làm chỉ nêu khi đúng.</p>\n"},{"key":"followup","label":"Sẽ bị hỏi tiếp","role":"next","answer":true,"empty":false,"html":"<ul>\n<li><strong>Bộ lọc phức tạp (nhiều điều kiện lồng nhau) thì URL có dài quá không?</strong> Có thể mã hoá gọn (chuỗi rút gọn) hoặc lưu bộ lọc ở server và chỉ đưa id lên URL (<code>?view=abc123</code>) — cũng là cách chia sẻ &quot;bộ lọc đã lưu&quot;.</li>\n<li><strong>Dữ liệu nhạy cảm có nên lên URL không?</strong> Không — URL bị ghi vào log server, lịch sử trình duyệt, header Referer. Số CMND, số tài khoản đầy đủ không đặt trên query param.</li>\n<li><strong>Đồng bộ form bộ lọc với URL thế nào?</strong> Form khởi tạo từ input (linkedSignal hoặc <code>setValue</code> khi input đổi), submit thì điều hướng — không hai chiều liên tục để tránh vòng lặp.</li>\n</ul>\n"},{"key":"traps","label":"Bẫy thường gặp","role":"caution","answer":true,"empty":false,"html":"<ul>\n<li><strong>Giữ filter cả trong state lẫn URL</strong> — hai nguồn lệch nhau.</li>\n<li><strong>Mỗi phím gõ tạo một mục lịch sử</strong> — back phải bấm hàng chục lần.</li>\n<li><strong>Tin query param</strong> — giá trị lạ làm lỗi API hoặc lỗ XSS nếu hiển thị.</li>\n</ul>\n"},{"key":"sources","label":"Nguồn","role":"reference","answer":false,"empty":false,"html":"<ul>\n<li><a href=\"https://angular.dev/guide/routing/navigate-to-routes\" target=\"_blank\" rel=\"noopener noreferrer\">Angular — Navigate to routes</a></li>\n<li><a href=\"https://angular.dev/guide/routing/read-route-state\" target=\"_blank\" rel=\"noopener noreferrer\">Angular — Read route state</a></li>\n</ul>\n"}]}