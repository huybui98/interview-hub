-dark:#E1E4E8\"> ANY(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">p</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">visited</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pairs p </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">JOIN</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> coa c </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">ON</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> c</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">parent_code</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> p</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">descendant</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  WHERE</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NOT</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> p</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">is_cycle</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT DISTINCT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ancestor </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> pairs </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> is_cycle </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">ORDER BY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ancestor;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">UPDATE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> coa </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">SET</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> parent_code </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> NULL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> code </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '111'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;     </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- sửa lại dữ liệu</span></span>\n<span class=\"line\"></span></code></pre></div>"},{"key":"real","label":"Thực tế trong dự án của tôi","role":"personal","answer":true,"empty":false,"html":"<blockquote>\n<p><strong>Ngữ cảnh</strong> dựng từ các hệ thống dữ liệu, báo cáo trong dự án bạn đã tham gia (vai trò chính của bạn là Angular). <strong>Tình huống điển hình</strong> là tình huống hay gặp với dữ liệu ngân hàng, bảo hiểm do app biên soạn để luyện cách kể; số liệu là ví dụ minh hoạ. Chưa làm trực tiếp thì kể là đã tìm hiểu hoặc luyện, đừng nhận là đã vận hành.</p>\n</blockquote>\n<p><strong>Ngữ cảnh:</strong> hệ thống kế toán của công ty bảo hiểm D (kế toán nội bộ) làm việc với bút toán và tài khoản kế toán; backend ASP.NET Core + SQL Server.</p>\n<ul>\n<li><strong>Đã làm:</strong> phía Frontend hiển thị dữ liệu bút toán, tài khoản; truy vấn cây phía backend chưa viết trực tiếp — đã làm bài này (SQL Server viết <code>WITH</code> không có chữ <code>RECURSIVE</code>, và không có mệnh đề <code>CYCLE</code>).</li>\n<li><strong>Kết quả:</strong> nói được cây tài khoản lưu và cộng dồn thế nào khi bị hỏi về báo cáo kế toán.</li>\n</ul>\n<p><strong>Tình huống điển hình:</strong> Bài tập: hệ thống tài khoản kế toán dạng cây; CTE đệ quy in đường dẫn như <code>1 &gt; 11 &gt; 1111</code> và cấp của từng tài khoản, rồi cộng dồn số dư từ tài khoản chi tiết lên tài khoản tổng hợp. Một dòng dữ liệu sai làm tài khoản trỏ về chính cây con của nó, truy vấn chạy vô hạn; thêm mảng đường dẫn đã đi qua và dừng khi gặp lại, hoặc dùng mệnh đề <code>CYCLE</code> của PostgreSQL.</p>\n"},{"key":"followup","label":"Sẽ bị hỏi tiếp","role":"next","answer":true,"empty":false,"html":"<ul>\n<li><strong>Cây 50.000 nút đọc liên tục, ít khi đổi thì lưu thế nào?</strong> Bảng closure (lưu sẵn mọi cặp tổ tiên–con cháu) hoặc <code>ltree</code>/materialized path để đọc không cần đệ quy; đổi lại cập nhật phức tạp hơn — xem <a href=\"i/data-model-hierarchy\">Lưu cấu trúc cây trong database — adjacency list + CTE đệ quy, materialized path (ltree), nested set, closure table; chọn theo tần suất đọc/ghi, độ sâu và kiểu truy vấn (cơ cấu chi nhánh, danh mục, phân cấp duyệt)</a>.</li>\n<li><strong>Oracle viết thế nào?</strong> Cú pháp riêng <code>START WITH … CONNECT BY PRIOR</code>, có <code>LEVEL</code>, <code>SYS_CONNECT_BY_PATH</code> và <code>NOCYCLE</code>; Oracle 11gR2+ cũng hỗ trợ CTE đệ quy chuẩn.</li>\n<li><strong>Thứ tự duyệt rộng (theo cấp) thay vì duyệt sâu?</strong> PostgreSQL 14+ có <code>SEARCH BREADTH FIRST BY code SET ord</code>; hoặc <code>ORDER BY lvl, path</code>.</li>\n</ul>\n"},{"key":"traps","label":"Bẫy thường gặp","role":"caution","answer":true,"empty":false,"html":"<ul>\n<li><strong>Phát hiện vòng bằng cách duyệt từ gốc</strong> — nút trong vòng không có gốc nên không bao giờ được thăm.</li>\n<li><strong>Dùng <code>UNION</code> thay <code>UNION ALL</code> để &quot;chặn vòng&quot;</strong> — chỉ chặn dòng trùng hoàn toàn; có cột cấp hoặc đường dẫn thay đổi thì vẫn chạy mãi.</li>\n<li><strong>Cộng dồn bằng JOIN từng cấp viết tay</strong> — sai khi cây sâu thêm một cấp.</li>\n</ul>\n"},{"key":"sources","label":"Nguồn","role":"reference","answer":false,"empty":false,"html":"<ul>\n<li><a href=\"https://www.postgresql.org/docs/current/queries-with.html\" target=\"_blank\" rel=\"noopener noreferrer\">PostgreSQL — WITH Queries: Recursive Queries, Search Order, Cycle Detection</a></li>\n<li><a href=\"https://www.postgresql.org/docs/current/functions-array.html\" target=\"_blank\" rel=\"noopener noreferrer\">PostgreSQL — Array Functions and Operators</a></li>\n</ul>\n"}]}