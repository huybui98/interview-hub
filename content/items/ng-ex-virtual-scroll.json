n style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (e.key </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'Enter'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">open</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">active</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">());</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  protected</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> open</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> row</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">rows</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()[i];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">    if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (row) </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.router.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">navigate</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">([</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/transactions'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, row.id]);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  protected</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> trackByIndex</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">i</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> number</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span></code></pre></div>"},{"key":"real","label":"Thực tế trong dự án của tôi","role":"personal","answer":true,"empty":false,"html":"<blockquote>\n<p><strong>Ngữ cảnh</strong> dựng từ dự án thật trong CV của bạn — kiểm tra lại chi tiết trước khi dùng. <strong>Tình huống điển hình</strong> là tình huống hay gặp ở dự án Angular ngân hàng, bảo hiểm do app biên soạn để luyện cách kể; số liệu trong đó là ví dụ minh hoạ. Khi phỏng vấn, chỉ nhận là của mình phần bạn đã thật sự làm; phần còn lại kể là tình huống đã tìm hiểu hoặc tái hiện.</p>\n</blockquote>\n<p><strong>Ngữ cảnh:</strong> ngân hàng A dùng <code>cdk-virtual-scroll</code> ở nhiều danh sách, ag-grid tự ảo hoá dòng; danh sách lớn còn dùng server-side row model.</p>\n<ul>\n<li><strong>Đã làm:</strong> danh sách chọn dài dùng <code>cdk-virtual-scroll-viewport</code>; bảng nghiệp vụ dùng ag-grid với tải theo trang từ server.</li>\n<li><strong>Kết quả:</strong> hàng nghìn dòng vẫn cuộn mượt; bài tập giúp hiểu phần ag-grid đang làm hộ.</li>\n</ul>\n<p><strong>Tình huống điển hình:</strong> Bài tập: bảng 10.000 giao dịch render hết làm cuộn giật và mở màn mất 3 giây. Dùng <code>cdk-virtual-scroll-viewport</code> chỉ render dòng trong khung nhìn; header dính bằng <code>position: sticky</code>; chọn dòng bằng phím mũi tên có <code>aria-activedescendant</code>; khi cuộn gần cuối thì tải trang tiếp từ server. Mở màn dưới 300 ms, cuộn mượt; với dòng cao khác nhau cần chiến lược đo kích thước riêng.</p>\n<p><strong>Lưu ý khi kể:</strong> Số dòng tối đa và kích thước dòng cố định hay không ở dự án thật chỉ nêu khi đúng.</p>\n"},{"key":"followup","label":"Sẽ bị hỏi tiếp","role":"next","answer":true,"empty":false,"html":"<ul>\n<li><strong>Vì sao <code>trackBy</code> theo index ở đây lại đúng?</strong> Danh sách có thứ tự cố định và vị trí chính là danh tính (dòng 5.000 luôn là dòng 5.000); phần tử từ <code>undefined</code> thành dữ liệu cần cập nhật tại chỗ, không tạo phần tử mới.</li>\n<li><strong><code>slice()</code> mảng 10.000 phần tử mỗi lần tải trang có đắt không?</strong> Vài trăm microgiây — chấp nhận được với tần suất tải trang; nếu cần tối ưu hơn, lưu theo trang (<code>Map&lt;page, Txn[]&gt;</code>) và tính dòng khi render.</li>\n<li><strong>Bộ lọc thay đổi thì sao?</strong> Reset mảng, <code>loaded</code>, cuộn về đầu, và dùng <code>switchMap</code> theo bộ lọc để huỷ các request của bộ lọc cũ.</li>\n</ul>\n"},{"key":"traps","label":"Bẫy thường gặp","role":"caution","answer":true,"empty":false,"html":"<ul>\n<li><strong>Chỉ đưa dòng đã tải vào viewport</strong> — thanh cuộn sai, không tới được cuối.</li>\n<li><strong>Không chống tải trùng</strong> — cuộn qua lại gọi cùng trang nhiều lần.</li>\n<li><strong>Focus vào từng dòng khi bấm mũi tên</strong> — dòng có thể bị viewport gỡ khỏi DOM; dùng <code>aria-activedescendant</code>.</li>\n</ul>\n"},{"key":"sources","label":"Nguồn","role":"reference","answer":false,"empty":false,"html":"<ul>\n<li><a href=\"https://developer.mozilla.org/en-US/docs/Web/Accessibility/ARIA\" target=\"_blank\" rel=\"noopener noreferrer\">MDN — ARIA</a></li>\n<li><a href=\"https://angular.dev/best-practices/runtime-performance\" target=\"_blank\" rel=\"noopener noreferrer\">Angular — Runtime performance</a></li>\n</ul>\n"}]}