583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> req</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> http.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">expectOne</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/api/transfers'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  expect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(req.request.headers.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Idempotency-Key'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toBeTruthy</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  req.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">flush</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ referenceNo: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'FT123'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  http.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">verify</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"></span></code></pre></div>"},{"key":"real","label":"Thực tế trong dự án của tôi","role":"personal","answer":true,"empty":false,"html":"<blockquote>\n<p><strong>Ngữ cảnh</strong> dựng từ dự án thật trong CV của bạn — kiểm tra lại chi tiết trước khi dùng. <strong>Tình huống điển hình</strong> là tình huống hay gặp ở dự án Angular ngân hàng, bảo hiểm do app biên soạn để luyện cách kể; số liệu trong đó là ví dụ minh hoạ. Khi phỏng vấn, chỉ nhận là của mình phần bạn đã thật sự làm; phần còn lại kể là tình huống đã tìm hiểu hoặc tái hiện.</p>\n</blockquote>\n<p><strong>Ngữ cảnh:</strong> ngân hàng A và công ty bảo hiểm C — nút gửi hồ sơ, gửi phê duyệt, xác nhận báo giá.</p>\n<ul>\n<li><strong>Đã làm:</strong> nối sự kiện bấm với <code>exhaustMap</code> để lần bấm trong lúc đang gửi bị bỏ qua, khoá nút; đề nghị backend kiểm tra idempotency.</li>\n<li><strong>Kết quả:</strong> không tạo trùng.</li>\n</ul>\n<p><strong>Tình huống điển hình:</strong> Bài tập: nút Chuyển tiền chờ 2 giây; người dùng bấm 4 lần tạo 4 request. Bản sửa phía client: nối sự kiện bấm với <code>exhaustMap</code> để bỏ qua các lần bấm khi đang gửi, khoá nút, sinh Idempotency-Key một lần cho mỗi ý định chuyển và dùng lại khi gửi lại sau timeout. Phía server: lưu key với ràng buộc duy nhất, trả kết quả cũ khi trùng. Test bấm 10 lần: chỉ một giao dịch.</p>\n<p><strong>Lưu ý khi kể:</strong> Chỗ dùng thật và việc backend có idempotency key chỉ nêu khi đúng.</p>\n"},{"key":"followup","label":"Sẽ bị hỏi tiếp","role":"next","answer":true,"empty":false,"html":"<ul>\n<li><strong>Vì sao không debounce nút?</strong> Debounce vẫn gửi sau khi ngừng bấm và không biết request trước đã xong chưa; <code>exhaustMap</code> gắn trực tiếp với vòng đời request.</li>\n<li><strong>Server xử lý idempotency thế nào khi hai request cùng key tới gần như đồng thời?</strong> Ràng buộc unique trên key trong cùng transaction với lệnh chuyển; request thứ hai chờ hoặc nhận kết quả của request thứ nhất — đây là câu hỏi backend hay bị hỏi tiếp.</li>\n<li><strong>Người dùng mở hai tab cùng gửi một lệnh?</strong> Hai tab có hai key khác nhau → hai lệnh hợp lệ theo server. Nếu nghiệp vụ cấm, cần kiểm tra trùng theo nội dung (cùng người nhận, cùng số tiền trong N phút) và hỏi xác nhận.</li>\n</ul>\n"},{"key":"traps","label":"Bẫy thường gặp","role":"caution","answer":true,"empty":false,"html":"<ul>\n<li><strong>Chỉ disable nút</strong> — Enter, double-click nhanh hoặc request chậm vẫn gửi trùng.</li>\n<li><strong>Sinh idempotency key mới mỗi lần bấm</strong> — mất tác dụng chống trùng khi bấm lại sau lỗi mạng.</li>\n<li><strong><code>switchMap</code> cho lệnh chuyển tiền</strong> — huỷ phản hồi không huỷ được việc server đã trừ tiền.</li>\n</ul>\n"},{"key":"sources","label":"Nguồn","role":"reference","answer":false,"empty":false,"html":"<ul>\n<li><a href=\"https://rxjs.dev/api/index/function/exhaustMap\" target=\"_blank\" rel=\"noopener noreferrer\">RxJS — exhaustMap</a></li>\n</ul>\n"}]}