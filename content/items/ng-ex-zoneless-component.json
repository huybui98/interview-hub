">me</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">().</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">subscribe</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">u</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.user </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> u));</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.sub </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.notif.count$.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">subscribe</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">n</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.unread </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> n));</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.timer </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> setInterval</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.secondsLeft </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Math.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">round</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.auth.expiresAt </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Date.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">now</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">/</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">      this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.warning </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.secondsLeft </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 60</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    }, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">1000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  extend</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.auth.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">extend</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">().</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">then</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.warning </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> false</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  ngOnDestroy</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">    this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.sub?.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">unsubscribe</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    clearInterval</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.timer);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span></code></pre></div>"},{"key":"requirements","label":"Yêu cầu","role":"prompt","answer":false,"empty":false,"html":"<ul>\n<li>Chạy đúng khi zoneless + OnPush, và vẫn đúng nếu app còn zone.js.</li>\n<li>Không dùng <code>markForCheck</code>/<code>detectChanges</code> (trừ khi giải thích được vì sao bắt buộc).</li>\n<li>Dọn dẹp đầy đủ, không cần <code>ngOnDestroy</code>.</li>\n<li><code>warning</code> và <code>secondsLeft</code> không phải là state độc lập — dẫn xuất từ thời điểm hết hạn.</li>\n<li>Có test chứng minh giao diện cập nhật.</li>\n</ul>\n"},{"key":"hints","label":"Gợi ý","role":"hint","answer":true,"empty":false,"html":"<ul>\n<li>Liệt kê từng chỗ gán field trong callback bất đồng bộ — đó là những chỗ hỏng.</li>\n<li><code>me()</code> và <code>count$</code> là Observable → <code>toSignal</code>.</li>\n<li>Đồng hồ: một signal <code>now</code> cập nhật mỗi giây; <code>secondsLeft</code> và <code>warning</code> là <code>computed</code>.</li>\n</ul>\n","items":["Liệt kê từng chỗ gán field trong callback bất đồng bộ — đó là những chỗ hỏng.","<code>me()</code> và <code>count$</code> là Observable → <code>toSignal</code>.","Đồng hồ: một signal <code>now</code> cập nhật mỗi giây; <code>secondsLeft</code> và <code>warning</code> là <code>computed</code>."]},{"key":"quick","label":"Câu trả lời tốt nhất","role":"primary","answer":true,"empty":false,"html":"<p>Có <strong>bốn chỗ hỏng</strong>, cùng một nguyên nhân: gán <strong>field thường</strong> trong callback bất đồng bộ — <code>subscribe</code> của <code>me()</code>, <code>subscribe</code> của <code>count$</code>, <code>setInterval</code>, và <code>.then()</code> của <code>extend()</code>. Zoneless không có gì báo Angular là cần render. Tôi sửa bằng cách đưa state thành <strong>signal</strong>: <code>user</code> và <code>unread</code> dùng <code>toSignal</code> — tự huỷ subscription; đồng hồ là một signal <code>now</code> cập nhật mỗi giây; <code>secondsLeft</code> và <code>warning</code> thành <strong><code>computed</code></strong> từ <code>now</code> và <code>expiresAt</code> — không còn state trùng lặp có thể lệch nhau. <code>extend()</code> không cần tự tắt cảnh báo: khi <code>expiresAt</code> (signal trong <code>AuthService</code>) được gia hạn, <code>warning</code> tự tính lại. Dọn dẹp bằng <code>DestroyRef</code>. Kết quả chạy đúng cả có zone lẫn không, vì signal báo thay đổi trong cả hai chế độ.</p>\n"},{"key":"deep","label":"Trả lời đầy đủ","role":"detail","answer":true,"empty":false,"html":"<h3>Bốn chỗ hỏng</h3>\n<table>\n<thead>\n<tr>\n<th>Dòng</th>\n<th>Vì sao hỏng khi zoneless</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><code>me().subscribe(u =&gt; this.user = u)</code></td>\n<td>HTTP xong không lên lịch render</td>\n</tr>\n<tr>\n<td><code>count$.subscribe(n =&gt; this.unread = n)</code></td>\n<td>WebSocket không lên lịch render</td>\n</tr>\n<tr>\n<td><code>setInterval(...)</code> gán <code>secondsLeft</code>, <code>warning</code></td>\n<td>timer không lên lịch render</td>\n</tr>\n<tr>\n<td><code>extend().then(() =&gt; this.warning = false)</code></td>\n<td>Promise không lên lịch render</td>\n</tr>\n<tr>\n<td>Riêng <code>(click)=&quot;extend()&quot;</code> có lên lịch render — nhưng lúc đó Promise chưa xong, nên render không thấy thay đổi.</td>\n<td></td>\n</tr>\n</tbody>\n</table>\n<h3>Thiết kế lại</h3>\n<ul>\n<li><strong>Nguồn sự thật</strong>: <code>auth.expiresAt</code> là <code>Signal&lt;number&gt;</code> trong service; gia hạn thì service set lại.</li>\n<li><strong>Dẫn xuất</strong>: <code>secondsLeft = computed(...)</code>, <code>warning = computed(...)</code> — không thể lệch nhau.</li>\n<li><strong>Thời gian</strong>: <code>now</code> signal, interval duy nhất, dọn bằng <code>DestroyRef</code>.</li>\n<li><strong>Observable → signal</strong>: <code>toSignal</code> với giá trị ban đầu rõ ràng.</li>\n</ul>\n<h3>Vì sao không cần <code>markForCheck</code></h3>\n<p><code>markForCheck</code> sửa được triệu chứng, nhưng phải nhớ gọi ở mọi callback hiện tại <strong>và tương lai</strong>. Signal đưa trách nhiệm báo thay đổi vào chính dữ liệu.</p>\n"},{"key":"code","label":"Code","role":"detail","answer":true,"empty":false,"html":"<div class=\"ih-code\" data-lang=\"ts\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// auth.service.ts (phần liên quan)</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">@</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Injectable</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ providedIn: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'root'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> })</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> AuthService</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  private</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> http</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> inject</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(HttpClient);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  private</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> _expiresAt</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> signal</span><span style=\"c