C5;--shiki-dark:#79B8FF\">null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> count</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> computed</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">cart</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()?.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">count</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">??</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 0</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">c</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> CartService</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) { </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.cart.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(c); }</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  clear</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">c</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> CartService</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) { </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">cart</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> c) </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.cart.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">set</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">null</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">); }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span></code></pre></div><h3>Vòng đời instance của route</h3>\n<p>Environment injector của route trước đây sống mãi sau lần tải đầu — giỏ (và đăng ký <code>ActiveCart</code>) không bao giờ bị huỷ khi chuyển giữa hai feature. Cách xử lý: đăng ký &quot;đang hoạt động&quot; theo <strong>sự kiện vào route</strong> (ví dụ trong component gốc của feature) thay vì constructor service; hoặc từ 22.2 bật <code>withAutoCleanupInjectors()</code> để router huỷ injector của route không còn dùng.</p>\n<h3>Kiểm tra</h3>\n<ul>\n<li>Angular DevTools → Injector tree: hai <code>CartService</code> dưới hai route injector.</li>\n<li>Test: tạo hai environment injector con với <code>CART_KIND</code> khác nhau, thêm món vào một bên, bên kia vẫn rỗng.</li>\n</ul>\n"},{"key":"framework","label":"Khung trả lời","role":"detail","answer":true,"empty":false,"html":"<ol>\n<li><strong>Phạm vi state</strong>: giỏ thuộc về feature, không thuộc về app.</li>\n<li><strong>Cơ chế</strong>: provider ở route tạo instance riêng; component dùng chung không cần đổi.</li>\n<li><strong>Phần ngoài phạm vi</strong> (header): cần một cầu nối — &quot;giỏ đang hoạt động&quot;.</li>\n<li><strong>Vòng đời</strong>: giỏ có giữ khi rời feature không, lưu ở đâu.</li>\n</ol>\n"},{"key":"real","label":"Thực tế trong dự án của tôi","role":"personal","answer":true,"empty":false,"html":"<blockquote>\n<p><strong>Ngữ cảnh</strong> dựng từ dự án thật trong CV của bạn — kiểm tra lại chi tiết trước khi dùng. <strong>Tình huống điển hình</strong> là tình huống hay gặp ở dự án Angular ngân hàng, bảo hiểm do app biên soạn để luyện cách kể; số liệu trong đó là ví dụ minh hoạ. Khi phỏng vấn, chỉ nhận là của mình phần bạn đã thật sự làm; phần còn lại kể là tình huống đã tìm hiểu hoặc tái hiện.</p>\n</blockquote>\n<p><strong>Ngữ cảnh:</strong> công ty bảo hiểm C — mỗi luồng báo giá cần state riêng (gói, thành viên) và không được lẫn giữa các luồng.</p>\n<ul>\n<li><strong>Đã làm:</strong> SignalStore của luồng khai báo ở <code>providers</code> của route feature thay vì <code>providedIn: 'root'</code>; rời luồng thì store bị huỷ.</li>\n<li><strong>Kết quả:</strong> cùng nguyên lý với giỏ &quot;mua lẻ&quot;/&quot;mua sỉ&quot;: state theo feature, không theo app.</li>\n</ul>\n<p><strong>Tình huống điển hình:</strong> Một service giỏ hàng <code>providedIn: 'root'</code> được dùng cho cả luồng báo giá cá nhân và gia đình; người dùng mở luồng thứ hai thấy gói đã chọn ở luồng đầu. Đội chuyển store sang <code>providers</code> của route từng luồng: mỗi luồng một instance, rời luồng thì store bị huỷ. Phần cần dùng chung giữa hai luồng như danh mục sản phẩm vẫn ở root.</p>\n<p><strong>Lưu ý khi kể:</strong> Store cụ thể và việc hai luồng mở cùng lúc chỉ nêu khi đúng.</p>\n"},{"key":"followup","label":"Sẽ bị hỏi tiếp","role":"next","answer":true,"empty":false,"html":"<ul>\n<li><strong>Vì sao không tạo <code>RetailCartService</code> và <code>WholesaleCartService</code> riêng?</strong> Component dùng chung phải biết inject cái nào → phải sửa thư viện; cùng token khác phạm vi là cách DI giải quyết đúng việc này.</li>\n<li><strong>Nếu hai feature là component (không phải route) cùng trên một trang?</strong> Provide ở <code>providers</code> của component gốc mỗi feature; element injector cho mỗi nhánh một instance.</li>\n<li><strong>Đơn hàng thanh toán xong cần xoá giỏ của đúng loại?</strong> Service thanh toán chạy trong phạm vi route đó inject đúng <code>CartService</code>; nếu thanh toán là route khác thì truyền <code>kind</code> và xoá theo khoá lưu trữ.</li>\n</ul>\n"},{"key":"traps","label":"Bẫy thường gặp","role":"caution","answer":true,"empty":false,"html":"<ul>\n<li><strong>Giữ <code>providedIn: 'root'</code> và thêm provider ở route</strong> — nơi nào quên provide sẽ lặng lẽ dùng giỏ chung.</li>\n<li><strong>Header inject <code>CartService</code> trực tiếp</strong> — nhận instance root (hoặc lỗi), không phải giỏ của feature.</li>\n<li><strong>Đăng ký &quot;giỏ đang hoạt động&quot; trong constructor service mà không lưu ý injector route sống lâu</strong> — badge hiển thị giỏ sai sau khi chuyển feature.</li>\n</ul>\n"},{"key":"sources","label":"Nguồn","role":"reference","answer":false,"empty":false,"html":"<ul>\n<li><a href=\"https://angular.dev/guide/di/hierarchical-dependency-injection\" target=\"_blank\" rel=\"noopener noreferrer\">Angular — Hierarchical injectors</a></li>\n<li><a href=\"https://angular.dev/best-practices/performance/lazy-loaded-routes\" target=\"_blank\" rel=\"noopener noreferrer\">Angular — Lazy loading routes</a></li>\n</ul>\n"}]}