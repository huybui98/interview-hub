an style=\"color:#6F42C1;--shiki-dark:#B392F0\">input</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getProperty</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">boolean</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'disabled'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">); }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// dùng</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> amount</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> loader.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getHarness</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(MoneyInputHarness.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">with</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ label: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Số tiền'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }));</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> amount.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">setValue</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'1250000'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">expect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">await</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> amount.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getDisplayValue</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toBe</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'1.250.000'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span></code></pre></div><h3>Khi nào đáng viết</h3>\n<table>\n<thead>\n<tr>\n<th>Tình huống</th>\n<th>Harness?</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Component trong design system/thư viện dùng chung</td>\n<td><strong>có</strong> — đi kèm như một phần API công khai</td>\n</tr>\n<tr>\n<td>Component phức tạp test ở nhiều nơi (bảng, date picker)</td>\n<td>có</td>\n</tr>\n<tr>\n<td>Component chỉ dùng trong một màn hình</td>\n<td>thường không — Testing Library là đủ</td>\n</tr>\n</tbody>\n</table>\n<h3>Lợi ích phụ</h3>\n<ul>\n<li>Người dùng thư viện viết test nhanh, không phải hiểu DOM nội bộ.</li>\n<li>Đổi cài đặt bên trong (thêm wrapper, đổi class) không làm vỡ test của các team khác — một dạng <strong>hợp đồng</strong>.</li>\n</ul>\n"},{"key":"real","label":"Thực tế trong dự án của tôi","role":"personal","answer":true,"empty":false,"html":"<blockquote>\n<p><strong>Ngữ cảnh</strong> dựng từ dự án thật trong CV của bạn — kiểm tra lại chi tiết trước khi dùng. <strong>Tình huống điển hình</strong> là tình huống hay gặp ở dự án Angular ngân hàng, bảo hiểm do app biên soạn để luyện cách kể; số liệu trong đó là ví dụ minh hoạ. Khi phỏng vấn, chỉ nhận là của mình phần bạn đã thật sự làm; phần còn lại kể là tình huống đã tìm hiểu hoặc tái hiện.</p>\n</blockquote>\n<p><strong>Ngữ cảnh:</strong> dự án dashboard realtime và dự án PLM dùng Angular Material — có harness sẵn cho dialog, select, table.</p>\n<ul>\n<li><strong>Đã làm:</strong> dùng <code>MatSelectHarness</code>, <code>MatDialogHarness</code> thay cho query class nội bộ của Material, nên nâng version Material không làm vỡ test.</li>\n<li><strong>Kết quả:</strong> biết khi nào tự viết harness: component dùng chung trong <code>libs/shared</code> mà nhiều team test.</li>\n</ul>\n<p><strong>Tình huống điển hình:</strong> Sau khi nâng thư viện Material, 40 test đỏ vì truy vấn class nội bộ như <code>.mat-mdc-select-trigger</code> đã đổi tên. Đội chuyển sang <code>MatSelectHarness</code> và <code>MatDialogHarness</code>: test thao tác qua API ổn định của harness, không phụ thuộc DOM bên trong. Với component dùng chung tự viết như ô nhập tiền, đội viết harness riêng để các màn khác test cùng cách. Lần nâng cấp sau không test nào vỡ vì đổi DOM.</p>\n<p><strong>Lưu ý khi kể:</strong> Chỉ nói có test dùng harness thật nếu đúng.</p>\n"},{"key":"followup","label":"Sẽ bị hỏi tiếp","role":"next","answer":true,"empty":false,"html":"<ul>\n<li><strong>Harness khác Testing Library thế nào?</strong> Testing Library truy vấn theo vai trò/nhãn — tốt cho phần tử HTML chuẩn; harness hợp với component phức tạp có hành vi riêng (overlay, nhiều phần). Hai cách dùng cùng nhau được.</li>\n<li><strong>Harness chạy được trong Playwright không?</strong> CDK có môi trường cho Protractor/Selenium; với Playwright có thư viện cộng đồng hỗ trợ harness — hoặc dùng locator của Playwright theo vai trò.</li>\n<li><strong>Vì sao mọi method của harness là async?</strong> Để chạy được ở cả môi trường e2e (giao tiếp với trình duyệt bất đồng bộ) và để chờ component ổn định sau mỗi thao tác.</li>\n</ul>\n"},{"key":"traps","label":"Bẫy thường gặp","role":"caution","answer":true,"empty":false,"html":"<ul>\n<li><strong>Selector theo class nội bộ của Material</strong> — vỡ khi nâng cấp thư viện.</li>\n<li><strong>Viết harness cho mọi component nhỏ</strong> — tốn công không cần thiết.</li>\n<li><strong>Harness lộ chi tiết DOM ra ngoài</strong> (trả <code>TestElement</code> thô) — mất ý nghĩa đóng gói.</li>\n</ul>\n"},{"key":"sources","label":"Nguồn","role":"reference","answer":false,"empty":false,"html":"<ul>\n<li><a href=\"https://angular.dev/guide/testing/component-harnesses-overview\" target=\"_blank\" rel=\"noopener noreferrer\">Angular — Component harnesses overview</a></li>\n<li><a href=\"https://angular.dev/guide/testing/creating-component-harnesses\" target=\"_blank\" rel=\"noopener noreferrer\">Angular — Creating component harnesses</a></li>\n</ul>\n"}]}