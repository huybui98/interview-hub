dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">it</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'total tính đúng'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> store</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> TestBed.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">inject</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(CartStore);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  store.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">add</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ planId: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'A'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'A'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, unitPrice: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">100</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  expect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(store.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">total</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toBe</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">100</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"></span></code></pre></div><h3>Test effect</h3>\n<div class=\"ih-code\" data-lang=\"ts\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">it</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'lưu vào storage khi state đổi'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, () </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> store</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> TestBed.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">inject</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(CartStore);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  store.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">add</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ planId: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'A'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, name: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'A'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, unitPrice: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">100</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  TestBed.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">tick</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();                                     </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// chạy effect đang chờ</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  expect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(localStorage.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">getItem</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'cart.v1'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toContain</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'\"planId\":\"A\"'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"></span></code></pre></div><h3>Hàm <code>inject</code> tuỳ chỉnh</h3>\n<div class=\"ih-code\" data-lang=\"ts\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> page</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> TestBed.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">runInInjectionContext</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> injectQueryParam</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'page'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'1'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span>\n<span class=\"line\"></span></code></pre></div><h3>Bảng chuyển đổi</h3>\n<table>\n<thead>\n<tr>\n<th>Cũ</th>\n<th>Zoneless / signal</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><code>fixture.detectChanges()</code> sau mỗi bước</td>\n<td><code>await fixture.whenStable()</code></td>\n</tr>\n<tr>\n<td><code>component.input = x</code></td>\n<td><code>fixture.componentRef.setInput('input', x)</code></td>\n</tr>\n<tr>\n<td><code>fakeAsync</code> + <code>tick()</code></td>\n<td><code>vi.useFakeTimers()</code> + <code>advanceTimersByTime</code></td>\n</tr>\n<tr>\n<td><code>TestBed.flushEffects()</code></td>\n<td><code>TestBed.tick()</code></td>\n</tr>\n<tr>\n<td><code>fixture.autoDetectChanges(false)</code></td>\n<td>không dùng — throws khi zoneless</td>\n</tr>\n</tbody>\n</table>\n"},{"key":"real","label":"Thực tế trong dự án của tôi","role":"personal","answer":true,"empty":false,"html":"<blockquote>\n<p><strong>Ngữ cảnh</strong> dựng từ dự án thật trong CV của bạn — kiểm tra lại chi tiết trước khi dùng. <strong>Tình huống điển hình</strong> là tình huống hay gặp ở dự án Angular ngân hàng, bảo hiểm do app biên soạn để luyện cách kể; số liệu trong đó là ví dụ minh hoạ. Khi phỏng vấn, chỉ nhận là của mình phần bạn đã thật sự làm; phần còn lại kể là tình huống đã tìm hiểu hoặc tái hiện.</p>\n</blockquote>\n<p><strong>Ngữ cảnh:</strong> interview-hub (dự án cá nhân, Angular 21.2 zoneless, Vitest) và công ty bảo hiểm C (Angular 21, Jest).</p>\n<ul>\n<li><strong>Đã làm:</strong> test component dùng <code>fixture.componentRef.setInput()</code> cho input signal, <code>await fixture.whenStable()</code> thay <code>fakeAsync</code>, <code>TestBed.tick()</code> để effect chạy trước khi kiểm tra.</li>\n<li><strong>Kết quả:</strong> test chạy ổn định khi không có zone.js.</li>\n</ul>\n<p><strong>Tình huống điển hình:</strong> Test component zoneless dùng <code>fakeAsync</code> và <code>tick</code> như cũ, giá trị signal đã đổi nhưng DOM chưa cập nhật nên test đỏ. Đội chuyển sang đặt input bằng <code>fixture.componentRef.setInput()</code>, chờ <code>await fixture.whenStable()</code> sau thao tác, gọi <code>TestBed.tick()</code> khi cần chạy effect; test effect bằng cách kiểm tra tác dụng phụ của nó thay vì gọi trực tiếp. Bộ test chạy ổn định không cần zone.js.</p>\n<p><strong>Lưu ý khi kể:</strong> Test cụ thể ở dự án chỉ nêu khi có.</p>\n"},{"key":"followup","label":"Sẽ bị hỏi tiếp","role":"next","answer":true,"empty":false,"html":"<ul>\n<li><strong>Vì sao không gán trực tiếp <code>component.accountId = ...</code> được nữa?</strong> Input signal là chỉ đọc; <code>setInput</code> đi qua cơ chế input thật của Angular (kể cả <code>transform</code>) và lên lịch render.</li>\n<li><strong>Test có cần <code>await</code> sau mỗi click không?</strong> Có nếu kiểm tra DOM — click lên lịch render bất đồng bộ trong zoneless; kiểm tra output/spy thì không cần nếu handler đồng bộ.</li>\n<li><strong>Làm sao bắt lỗi &quot;quên báo thay đổi&quot; trong test?</strong> Chỉ dùng <code>whenStable</code> (không <code>detectChanges</code>), và bật <code>provideCheckNoChangesForDebug</code> trong môi trường test khi cần.</li>\n</ul>\n"},{"key":"traps","label":"Bẫy thường gặp","role":"caution","answer":true,"empty":false,"html":"<ul>\n<li><strong>Rải <code>detectChanges()</code></strong> — test pass trong khi app thật không cập nhật.</li>\n<li><strong>Kiểm tra DOM ngay sau <code>setInput</code> mà không chờ</strong> — đọc DOM cũ.</li>\n<li><strong>Dùng <code>TestBed.flushEffects()</code></strong> — đã deprecated, dùng <code>TestBed.tick()</code>.</li>\n</ul>\n"},{"key":"sources","label":"Nguồn","role":"reference","answer":false,"empty":false,"html":"<ul>\n<li><a href=\"https://angular.dev/guide/testing/components-basics\" target=\"_blank\" rel=\"noopener noreferrer\">Angular — Testing components basics</a></li>\n<li><a href=\"https://angular.dev/guide/testing/utility-apis\" target=\"_blank\" rel=\"noopener noreferrer\">Angular — Testing utility APIs</a></li>\n</ul>\n"}]}