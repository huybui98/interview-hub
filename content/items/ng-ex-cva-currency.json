span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'1.250.000'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  input.value </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '1.250.9000'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; input.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">setSelectionRange</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">7</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">7</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">); </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// vừa gõ \"9\" sau \"1.250.\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  input.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">dispatchEvent</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">new</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Event</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'input'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">));</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  expect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(f.componentInstance.c.value).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toBe</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">12509000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  expect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(input.value).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toBe</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'12.509.000'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  expect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(input.selectionStart).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toBe</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">6</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">); </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// ngay sau \"12.509\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"></span></code></pre></div>"},{"key":"real","label":"Thực tế trong dự án của tôi","role":"personal","answer":true,"empty":false,"html":"<blockquote>\n<p><strong>Ngữ cảnh</strong> dựng từ dự án thật trong CV của bạn — kiểm tra lại chi tiết trước khi dùng. <strong>Tình huống điển hình</strong> là tình huống hay gặp ở dự án Angular ngân hàng, bảo hiểm do app biên soạn để luyện cách kể; số liệu trong đó là ví dụ minh hoạ. Khi phỏng vấn, chỉ nhận là của mình phần bạn đã thật sự làm; phần còn lại kể là tình huống đã tìm hiểu hoặc tái hiện.</p>\n</blockquote>\n<p><strong>Ngữ cảnh:</strong> dự án tra soát của ngân hàng A có component <code>input-currency</code> dùng cho số tiền khiếu nại (có commit &quot;fix currency&quot; của tôi); app doanh nghiệp của ngân hàng B cũng có <code>input-currency</code> dùng chung; hệ thống kế toán của công ty bảo hiểm D nhập số tiền bút toán.</p>\n<ul>\n<li><strong>Đã làm:</strong> ô hiển thị có dấu ngăn cách nhưng giá trị form là <code>number</code>, xử lý dán chuỗi có chữ, giữ vị trí con trỏ khi chèn dấu; <code>writeValue</code> không gọi <code>onChange</code>.</li>\n<li><strong>Kết quả:</strong> backend luôn nhận số, không nhận chuỗi định dạng; tránh bẫy <code>parseFloat('1.500.000')</code> ra 1.5.</li>\n</ul>\n<p><strong>Tình huống điển hình:</strong> Bài tập: ô nhập số tiền bản đầu định dạng lại cả chuỗi mỗi lần gõ, con trỏ nhảy về cuối khi người dùng sửa số ở giữa; dán <code>1.250.000 đ</code> thì giá trị form thành <code>NaN</code>. Bản sửa: tính lại vị trí con trỏ theo số chữ số đứng trước nó, chỉ giữ chữ số khi dán, giá trị form là <code>number</code>, cài <code>ControlValueAccessor</code> đủ 4 method để dùng với <code>formControlName</code>. Test các trường hợp gõ giữa, xoá, dán.</p>\n<p><strong>Lưu ý khi kể:</strong> Lỗi cụ thể đã sửa trong commit sửa ô tiền chỉ nêu khi bạn nhớ rõ.</p>\n"},{"key":"followup","label":"Sẽ bị hỏi tiếp","role":"next","answer":true,"empty":false,"html":"<ul>\n<li><strong>Dán chuỗi &quot;1,250,000 VND&quot; (định dạng Mỹ) thì sao?</strong> Thuật toán chỉ giữ chữ số nên vẫn ra 1250000 — đúng với số nguyên. Nếu hỗ trợ ngoại tệ có phần thập phân, phải biết dấu thập phân theo locale trước khi lọc.</li>\n<li><strong>Vì sao không dùng <code>(keydown)</code> để chặn phím không phải số?</strong> Không bắt được dán, kéo thả, gõ bằng IME hay nhập bằng giọng nói; xử lý ở sự kiện <code>input</code> (hoặc <code>beforeinput</code>) bao quát hơn.</li>\n<li><strong>Số tiền lớn hơn <code>Number.MAX_SAFE_INTEGER</code>?</strong> VND tới nghìn tỷ vẫn an toàn (2^53 ≈ 9 triệu tỷ); vượt nữa thì giá trị form nên là chuỗi số hoặc <code>bigint</code>, và backend dùng <code>BigDecimal</code>.</li>\n</ul>\n"},{"key":"traps","label":"Bẫy thường gặp","role":"caution","answer":true,"empty":false,"html":"<ul>\n<li><strong>Giá trị form là chuỗi đã định dạng</strong> — mọi chỗ tính toán phải parse lại, dễ sai.</li>\n<li><strong>Đặt lại <code>value</code> mà không xử lý con trỏ</strong> — con trỏ nhảy về cuối, người dùng không sửa ở giữa được.</li>\n<li><strong><code>type=&quot;number&quot;</code></strong> — không hiển thị được dấu phân cách và cuộn chuột làm đổi số tiền.</li>\n</ul>\n"},{"key":"sources","label":"Nguồn","role":"reference","answer":false,"empty":false,"html":"<ul>\n<li><a href=\"https://angular.dev/guide/forms/reactive-forms\" target=\"_blank\" rel=\"noopener noreferrer\">Angular — Reactive forms</a></li>\n<li><a href=\"https://angular.dev/guide/forms/signals/custom-controls\" target=\"_blank\" rel=\"noopener noreferrer\">Angular — Signal Forms custom controls</a></li>\n</ul>\n"}]}