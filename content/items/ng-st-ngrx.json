:#24292E;--shiki-dark:#E1E4E8\">({ result })),</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">          catchError</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">e</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> of</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(TransferActions.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">submitFailed</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ message: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toMessage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(e) }))),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        ),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      ),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  { functional: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// component</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">protected readonly status </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> inject</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(Store).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">selectSignal</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(transferFeature.selectStatus);</span></span>\n<span class=\"line\"></span></code></pre></div><h3>Lỗi hay gặp</h3>\n<table>\n<thead>\n<tr>\n<th>Lỗi</th>\n<th>Hậu quả</th>\n<th>Sửa</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Action dạng lệnh (<code>setX</code>) dùng lại ở mọi nơi</td>\n<td>mất ý nghĩa &quot;chuyện gì xảy ra&quot;, DevTools khó đọc</td>\n<td>action theo sự kiện, có <code>source</code></td>\n</tr>\n<tr>\n<td>Mọi thứ vào store</td>\n<td>boilerplate khổng lồ</td>\n<td>UI tạm ở component</td>\n</tr>\n<tr>\n<td><code>mergeMap</code> cho lệnh ghi trong effect</td>\n<td>gửi trùng</td>\n<td><code>exhaustMap</code>/<code>concatMap</code></td>\n</tr>\n<tr>\n<td><code>catchError</code> ngoài nhánh trong effect</td>\n<td>effect chết sau lỗi đầu</td>\n<td><code>catchError</code> trong nhánh</td>\n</tr>\n<tr>\n<td>Selector trả object mới mỗi lần</td>\n<td>render thừa</td>\n<td>selector có nhớ, <code>createSelector</code></td>\n</tr>\n<tr>\n<td>Sửa state trong reducer tại chỗ</td>\n<td>lỗi khó thấy</td>\n<td>runtime check immutability bật ở dev</td>\n</tr>\n</tbody>\n</table>\n"},{"key":"real","label":"Thực tế trong dự án của tôi","role":"personal","answer":true,"empty":false,"html":"<blockquote>\n<p><strong>Ngữ cảnh</strong> dựng từ dự án thật trong CV của bạn — kiểm tra lại chi tiết trước khi dùng. <strong>Tình huống điển hình</strong> là tình huống hay gặp ở dự án Angular ngân hàng, bảo hiểm do app biên soạn để luyện cách kể; số liệu trong đó là ví dụ minh hoạ. Khi phỏng vấn, chỉ nhận là của mình phần bạn đã thật sự làm; phần còn lại kể là tình huống đã tìm hiểu hoặc tái hiện.</p>\n</blockquote>\n<p><strong>Ngữ cảnh:</strong> ngân hàng A (Angular 16, Nx) có <code>libs/store</code> dùng <code>@ngrx/store</code>, <code>effects</code>, <code>entity</code>, <code>component-store</code>; app doanh nghiệp của ngân hàng B (Angular 15) chia sẻ <code>@ngrx/store</code> qua Module Federation.</p>\n<ul>\n<li><strong>Đã làm:</strong> đọc và sửa luồng action → reducer → effect → selector; effect phải bắt lỗi bên trong <code>switchMap</code> để luồng không chết; với Module Federation store phải singleton giữa shell và remote.</li>\n<li><strong>Kết quả:</strong> biết NgRx cổ điển từ dự án thật và lý do dự án mới (hệ thống kế toán của công ty bảo hiểm D, công ty bảo hiểm C) chọn SignalStore.</li>\n</ul>\n<p><strong>Tình huống điển hình:</strong> Người dùng bấm lọc nhanh nhiều lần, danh sách hiện kết quả của lần lọc cũ: effect dùng <code>mergeMap</code> nên request cũ về sau ghi đè. Đổi sang <code>switchMap</code> trong effect. Một lỗi khác: reducer sửa trực tiếp state nên selector không phát giá trị mới. Đội ghi quy ước: reducer thuần và bất biến, effect chọn đúng operator theo ý nghĩa, selector có ghi nhớ cho dữ liệu dẫn xuất; dùng <code>@ngrx/entity</code> cho danh sách.</p>\n<p><strong>Lưu ý khi kể:</strong> State nào nằm trong store ở dự án chỉ nêu khi đúng; nói rõ phần bạn tự làm.</p>\n"},{"key":"followup","label":"Sẽ bị hỏi tiếp","role":"next","answer":true,"empty":false,"html":"<ul>\n<li><strong>Vì sao action nên mô tả sự kiện thay vì lệnh?</strong> Một sự kiện có thể khiến nhiều reducer/effect phản ứng; khi đọc log ta biết <strong>ai</strong> gây ra thay đổi — &quot;good action hygiene&quot; trong tài liệu NgRx.</li>\n<li><strong>Effect có nên trả về nhiều action không?</strong> Được, nhưng chuỗi action dây chuyền dài khó lần theo; ưu tiên một action kết quả và để reducer xử lý.</li>\n<li><strong>Entity adapter dùng làm gì?</strong> Lưu collection dạng <code>{ ids, entities }</code> với các hàm thêm/sửa/xoá sẵn, chuẩn hoá dữ liệu để tra theo id O(1).</li>\n</ul>\n"},{"key":"traps","label":"Bẫy thường gặp","role":"caution","answer":true,"empty":false,"html":"<ul>\n<li><strong>Dispatch action trong reducer</strong> — reducer phải thuần.</li>\n<li><strong>Dùng store để truyền sự kiện tạm thời giữa hai component</strong> — dùng output hoặc service.</li>\n<li><strong>Bỏ qua <code>exhaustMap</code> cho submit</strong> — trùng lệnh.</li>\n</ul>\n"},{"key":"sources","label":"Nguồn","role":"reference","answer":false,"empty":false,"html":"<ul>\n<li><a href=\"https://ngrx.io/guide/store\" target=\"_blank\" rel=\"noopener noreferrer\">NgRx — Store</a></li>\n</ul>\n"}]}