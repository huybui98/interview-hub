lor:#6F42C1;--shiki-dark:#B392F0\">pipe</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">            tapResponse</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">              next</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">loans</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> patchState</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(store, </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">setAllEntities</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(loans)),</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">              error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">e</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> Error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> console.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">error</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(e),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">            }),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">          ),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">        ),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      ),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    ),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  })),</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  withHooks</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">onInit</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">store</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> store.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">load</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() }),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"></span></code></pre></div><div class=\"ih-code\" data-lang=\"ts\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">@</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Component</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ providers: [LoanStore] </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">/* sống theo màn hình */</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> })</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> LoanListPage</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  protected</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> store</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> inject</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(LoanStore);</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span></code></pre></div><h3>Những điểm hay bị hỏi</h3>\n<table>\n<thead>\n<tr>\n<th>Khái niệm</th>\n<th>Điều cần nói</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Thứ tự feature</td>\n<td>Feature sau thấy feature trước; đặt <code>withProps</code> trước <code>withComputed</code> nếu computed cần dependency</td>\n</tr>\n<tr>\n<td><code>protectedState</code></td>\n<td>Mặc định <code>true</code>: ngoài store không <code>patchState</code> được — giữ quy tắc &quot;chỉ đổi state qua method có tên nghiệp vụ&quot;</td>\n</tr>\n<tr>\n<td>Tiền tố <code>_</code></td>\n<td>State, computed, prop, method bắt đầu bằng <code>_</code> là private</td>\n</tr>\n<tr>\n<td><code>rxMethod</code> vs <code>signalMethod</code></td>\n<td>Cần toán tử RxJS (debounce, switchMap) → <code>rxMethod</code>; side effect đơn giản theo giá trị → <code>signalMethod</code></td>\n</tr>\n<tr>\n<td><code>withLinkedState</code></td>\n<td>State ghi được nhưng tự reset theo signal khác (giống <code>linkedSignal</code>)</td>\n</tr>\n<tr>\n<td>Phạm vi</td>\n<td><code>providedIn: 'root'</code> = toàn app; <code>providers</code> của component/route = tạo mới mỗi lần, huỷ theo component</td>\n</tr>\n<tr>\n<td>Custom feature</td>\n<td><code>signalStoreFeature(...)</code> đóng gói khuôn dùng lại (trạng thái request, phân trang)</td>\n</tr>\n</tbody>\n</table>\n<h3>Test</h3>\n<div class=\"ih-code\" data-lang=\"ts\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">TestBed.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">configureTestingModule</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ providers: [LoanStore, { provide: LoanApi, useValue: fakeApi }] });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> store</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> TestBed.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">inject</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(LoanStore);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">patchState</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">unprotected</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(store), </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">setAllEntities</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">([loanA, loanB]));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">store.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">setFilter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'An'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">expect</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(store.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">visible</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">()).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toEqual</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">([loanA]);</span></span>\n<span class=\"line\"></span></code></pre></div><p><code>unprotected</code> (từ <code>@ngrx/signals/testing</code>) chỉ dùng trong test để dựng trạng thái nhanh; logic thật vẫn đi qua method.</p>\n"},{"key":"real","label":"Thực tế trong dự án của tôi","role":"personal","answer":true,"empty":false,"html":"<blockquote>\n<p><strong>Ngữ cảnh</strong> dựng từ dự án thật trong CV của bạn — kiểm tra lại chi tiết trước khi dùng. <strong>Tình huống điển hình</strong> là tình huống hay gặp ở dự án Angular ngân hàng, bảo hiểm do app biên soạn để luyện cách kể; số liệu trong đó là ví dụ minh hoạ. Khi phỏng vấn, chỉ nhận là của mình phần bạn đã thật sự làm; phần còn lại kể là tình huống đã tìm hiểu hoặc tái hiện.</p>\n</blockquote>\n<p><strong>Ngữ cảnh:</strong> hệ thống kế toán của công ty bảo hiểm D (Angular 20) và công ty bảo hiểm C (Angular 21, <code>@ngrx/signals</code> 21) dùng NgRx SignalStore cho các feature.</p>\n<ul>\n<li><strong>Đã làm:</strong> <code>withState</code>, <code>withComputed</code>, <code>withMethods</code>, <code>rxMethod</code> cho tải dữ liệu có debounce và hủy request cũ, <code>withHooks</code> để tải khi khởi tạo; store cung cấp theo route để tự hủy khi rời feature.</li>\n<li><strong>Kết quả:</strong> kể được cách tổ chức store thật ở hai dự án.</li>\n</ul>\n<p><strong>Tình huống điển hình:</strong> Store tra cứu danh sách tải dữ liệu bằng <code>withMethods</code> gọi <code>subscribe</code> thủ công, đổi bộ lọc nhanh thì nhiều request chạy song song. Đội chuyển sang <code>rxMethod</code> nhận signal bộ lọc với <code>debounceTime</code> và <code>switchMap</code>; danh sách quản lý bằng <code>withEntities</code>; trạng thái tải tách thành <code>signalStoreFeature</code> dùng lại; thành viên bắt đầu bằng dấu gạch dưới là private; <code>withHooks</code> tải lần đầu khi store khởi tạo. Hết request song song.</p>\n<p><strong>Lưu ý khi kể:</strong> Store cụ thể và việc dùng <code>withEntities</code>, <code>signalStoreFeature</code> chỉ nêu khi đúng.</p>\n"},{"key":"followup","label":"Sẽ bị hỏi tiếp","role":"next","answer":true,"empty":false,"html":"<ul>\n<li><strong>Hai component cùng inject một store khai báo ở <code>providers</code> của mỗi component thì sao?</strong> Mỗi component có một instance riêng — muốn chia sẻ thì khai báo ở component cha hoặc route chung.</li>\n<li><strong>Có cần <code>effect</code> trong store không?</strong> Hiếm; dùng <code>signalMethod</code>/<code>rxMethod</code> có tên rõ ràng, hoặc <code>withHooks</code> cho khởi tạo.</li>\n<li><strong>Debug SignalStore thế nào?</strong> Đọc trực tiếp signal trong Angular DevTools; có thư viện cộng đồng (ngrx-toolkit) nối Redux DevTools nếu team cần xem lịch sử.</li>\n</ul>\n"},{"key":"traps","label":"Bẫy thường gặp","role":"caution","answer":true,"empty":false,"html":"<ul>\n<li><strong>Đặt store ở root cho state của một màn hình</strong> — dữ liệu cũ còn khi quay lại màn, rò dữ liệu giữa các khách hàng.</li>\n<li><strong>Tắt <code>protectedState</code> để component tự <code>patchState</code></strong> — mất điểm kiểm soát duy nhất cho thay đổi state.</li>\n<li><strong>Khởi tạo store bằng <code>new</code> trong test</strong> — <code>inject</code>, <code>rxMethod</code> cần injection context, phải dùng <code>TestBed</code>.</li>\n</ul>\n"},{"key":"sources","label":"Nguồn","role":"reference","answer":false,"empty":false,"html":"<ul>\n<li><a href=\"https://ngrx.io/guide/signals/signal-store\" target=\"_blank\" rel=\"noopener noreferrer\">NgRx — SignalStore guide</a></li>\n<li><a href=\"https://ngrx.io/guide/signals/signal-store/private-store-members\" target=\"_blank\" rel=\"noopener noreferrer\">NgRx — Private store members</a></li>\n<li><a href=\"https://ngrx.io/guide/signals/signal-store/testing\" target=\"_blank\" rel=\"noopener noreferrer\">NgRx — Testing SignalStore</a></li>\n<li><a href=\"https://ngrx.io/api/signals/signalMethod\" target=\"_blank\" rel=\"noopener noreferrer\">NgRx — signalMethod API</a></li>\n</ul>\n"}]}