> { filter, page, patch };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// Dùng</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> CustomerList</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  protected</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> list</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> injectListState</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ q: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">''</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, status: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'ACTIVE'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  protected</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> readonly</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\"> data</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> httpResource</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Page</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Customer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>>(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    url: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'/api/customers'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    params: { </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">...</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.list.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">filter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(), page: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.list.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">page</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  }));</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span></code></pre></div><h3>Composition bằng directive</h3>\n<div class=\"ih-code\" data-lang=\"ts\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">@</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Component</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  selector: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'app-data-table'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  hostDirectives: [</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { directive: CdkFocusTrap },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">    { directive: SortableTable, inputs: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'sortKey'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">], outputs: [</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'sortChange'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">] },</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  ],</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  template: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">`...`</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">})</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> class</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> DataTable</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {}</span></span>\n<span class=\"line\"></span></code></pre></div><h3>Khi nào kế thừa vẫn hợp lý</h3>\n<ul>\n<li>Lớp <strong>trừu tượng nhỏ, ổn định</strong> định nghĩa hợp đồng, ví dụ <code>abstract class FormStepComponent { abstract isValid(): boolean }</code> dùng làm token DI.</li>\n<li>Mở rộng component thư viện mà thư viện thiết kế để kế thừa.\nNgay cả khi đó, giữ lớp cha <strong>không có state</strong> và một tầng duy nhất.</li>\n</ul>\n"},{"key":"real","label":"Thực tế trong dự án của tôi","role":"personal","answer":true,"empty":false,"html":"<blockquote>\n<p><strong>Ngữ cảnh</strong> dựng từ dự án thật trong CV của bạn — kiểm tra lại chi tiết trước khi dùng. <strong>Tình huống điển hình</strong> là tình huống hay gặp ở dự án Angular ngân hàng, bảo hiểm do app biên soạn để luyện cách kể; số liệu trong đó là ví dụ minh hoạ. Khi phỏng vấn, chỉ nhận là của mình phần bạn đã thật sự làm; phần còn lại kể là tình huống đã tìm hiểu hoặc tái hiện.</p>\n</blockquote>\n<p><strong>Ngữ cảnh:</strong> app enterprise cũ — <code>BaseListComponent</code> dài hàng trăm dòng được 20 màn kế thừa, sửa một chỗ vỡ nhiều nơi.</p>\n<ul>\n<li><strong>Đã làm:</strong> ở dự án sau chuyển sang composition: hàm <code>inject...()</code> dùng lại, directive qua <code>hostDirectives</code>, service theo feature.</li>\n<li><strong>Kết quả:</strong> màn mới chỉ lấy đúng phần cần; test từng phần độc lập.</li>\n</ul>\n<p><strong>Tình huống điển hình:</strong> <code>BaseListComponent</code> 600 dòng được 20 màn kế thừa; sửa logic phân trang cho một màn làm vỡ 5 màn khác, và màn nào cũng phải gọi <code>super</code> đúng thứ tự. Đội chuyển sang composition: hàm <code>injectPagination()</code> dùng lại logic phân trang, <code>hostDirectives</code> gắn hành vi lên component, service riêng cho xuất file. Mỗi màn chỉ lấy đúng thứ cần; sửa phân trang không còn làm vỡ màn khác.</p>\n<p><strong>Lưu ý khi kể:</strong> Số màn kế thừa base class và lỗi do sửa base class chỉ nêu khi bạn nhớ rõ.</p>\n"},{"key":"followup","label":"Sẽ bị hỏi tiếp","role":"next","answer":true,"empty":false,"html":"<ul>\n<li><strong>Hàm <code>injectX()</code> khác service thế nào?</strong> Service là singleton theo phạm vi provider; hàm <code>inject</code> tạo <strong>state riêng cho từng component</strong> gọi nó, nhưng vẫn dùng được DI và <code>DestroyRef</code> vì chạy trong injection context.</li>\n<li><strong><code>hostDirectives</code> có giới hạn gì?</strong> Directive phải standalone, input/output phải được khai báo rõ để lộ ra ngoài, và không thể bỏ điều kiện — muốn bật tắt thì dùng directive thường trong template.</li>\n<li><strong>Đã có <code>BaseComponent</code> trong dự án lớn thì làm sao bỏ?</strong> Không đập đi một lần: tách từng năng lực ra hàm hoặc directive, chuyển dần từng màn hình, khi lớp cha rỗng thì xoá.</li>\n</ul>\n"},{"key":"traps","label":"Bẫy thường gặp","role":"caution","answer":true,"empty":false,"html":"<ul>\n<li><strong>Lớp cha có <code>destroy$ = new Subject()</code> cho mọi component</strong> — <code>takeUntilDestroyed()</code> đã giải quyết, không cần kế thừa.</li>\n<li><strong>Dùng cờ cấu hình để lớp cha &quot;linh hoạt&quot;</strong> — mỗi cờ nhân đôi số trường hợp phải test.</li>\n<li><strong>Gom mọi hành vi chung vào một service root</strong> — trộn state của nhiều màn hình; state theo màn hình thuộc về hàm <code>inject</code> hoặc service provide ở component.</li>\n</ul>\n"},{"key":"sources","label":"Nguồn","role":"reference","answer":false,"empty":false,"html":"<ul>\n<li><a href=\"https://angular.dev/guide/components/inheritance\" target=\"_blank\" rel=\"noopener noreferrer\">Angular — Inheritance</a></li>\n<li><a href=\"https://angular.dev/guide/directives/directive-composition-api\" target=\"_blank\" rel=\"noopener noreferrer\">Angular — Directive composition API</a></li>\n</ul>\n"}]}