olor:#24292E;--shiki-dark:#E1E4E8\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"members.length === 1\"</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> [attr.aria-label]</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"'Xoá người thứ ' + (i + 1)\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>Xoá&#x3C;/</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">button</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  &#x3C;/</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">fieldset</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">&#x3C;</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">button</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> type</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"button\"</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> (click)</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"add()\"</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> [disabled]</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"members.length >= 10\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">>Thêm người&#x3C;/</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">button</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">></span></span>\n<span class=\"line\"></span></code></pre></div><h3>Vì sao <code>track m</code></h3>\n<table>\n<thead>\n<tr>\n<th><code>track</code></th>\n<th>Xoá dòng 2 trong 4</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><code>$index</code></td>\n<td>DOM dòng 2 dùng lại cho dữ liệu dòng 3, dòng cuối bị huỷ — focus và state UI lệch</td>\n</tr>\n<tr>\n<td><code>m</code> (FormGroup)</td>\n<td>đúng DOM của dòng 2 bị huỷ, các dòng khác giữ nguyên</td>\n</tr>\n</tbody>\n</table>\n<h3>Validator trên mảng</h3>\n<div class=\"ih-code\" data-lang=\"ts\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> onlyOneSelf</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> ValidatorFn</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">arr</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> n</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (arr </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">as</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> FormArray</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).controls.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">filter</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">((</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">c</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> c.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">get</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'relation'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)?.value </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'SELF'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">length</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> n </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ?</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> null</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> :</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { onlyOneSelf: { count: n } };</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">};</span></span>\n<span class=\"line\"></span></code></pre></div><h3>Signal Forms</h3>\n<p>Model là mảng trong signal; thêm/xoá bằng <code>model.update</code>. Phần tử là object được <strong>tự gán định danh theo dõi</strong>, nên sắp xếp lại không làm lệch trạng thái field.</p>\n"},{"key":"real","label":"Thực tế trong dự án của tôi","role":"personal","answer":true,"empty":false,"html":"<blockquote>\n<p><strong>Ngữ cảnh</strong> dựng từ dự án thật trong CV của bạn — kiểm tra lại chi tiết trước khi dùng. <strong>Tình huống điển hình</strong> là tình huống hay gặp ở dự án Angular ngân hàng, bảo hiểm do app biên soạn để luyện cách kể; số liệu trong đó là ví dụ minh hoạ. Khi phỏng vấn, chỉ nhận là của mình phần bạn đã thật sự làm; phần còn lại kể là tình huống đã tìm hiểu hoặc tái hiện.</p>\n</blockquote>\n<p><strong>Ngữ cảnh:</strong> công ty bảo hiểm C — báo giá gia đình thêm/xoá thành viên; ngân hàng A — danh sách tài sản, chủ sở hữu trong một hồ sơ (FormArray ở nhiều màn).</p>\n<ul>\n<li><strong>Đã làm:</strong> mỗi dòng là một <code>FormGroup</code> tạo từ factory, <code>@for</code> track theo id ổn định chứ không theo index; xoá dòng thì cập nhật lại validator phụ thuộc số dòng.</li>\n<li><strong>Kết quả:</strong> thêm/xoá không làm mất dữ liệu dòng khác hay nhảy focus.</li>\n</ul>\n<p><strong>Tình huống điển hình:</strong> Danh sách thành viên dùng <code>FormArray</code>; xoá thành viên thứ 2 trên 5 thì lỗi validate của thành viên 3 hiện ở thành viên 2, vì <code>@for</code> track theo <code>$index</code>. Đội gán id ổn định khi tạo mỗi <code>FormGroup</code> từ factory, track theo id, xoá bằng <code>removeAt</code> theo vị trí tìm từ id; giới hạn tối đa số thành viên bằng validator ở cấp mảng. Hết lỗi lệch dòng.</p>\n<p><strong>Lưu ý khi kể:</strong> Số dòng tối đa và lỗi index cụ thể chỉ nêu khi đúng.</p>\n"},{"key":"followup","label":"Sẽ bị hỏi tiếp","role":"next","answer":true,"empty":false,"html":"<ul>\n<li><strong><code>setValue</code> với mảng có số phần tử khác có được không?</strong> Không — <code>setValue</code> yêu cầu đúng cấu trúc; <code>patchValue</code> bỏ qua phần tử thừa và không tạo phần tử mới. Phải dựng lại control.</li>\n<li><strong>Kéo thả sắp xếp lại người được bảo hiểm?</strong> <code>moveItemInArray</code> trên <code>controls</code> không cập nhật form đúng cách; dùng <code>removeAt</code> + <code>insert</code> (hoặc tạo mảng control mới) để <code>value</code> theo đúng thứ tự.</li>\n<li><strong>FormArray 100 dòng có chậm không?</strong> Mỗi thay đổi tính lại validity lên tới gốc; thêm hàng loạt thì dùng <code>emitEvent: false</code> rồi <code>updateValueAndValidity()</code> một lần, và cân nhắc <code>updateOn: 'blur'</code>.</li>\n</ul>\n"},{"key":"traps","label":"Bẫy thường gặp","role":"caution","answer":true,"empty":false,"html":"<ul>\n<li><strong><code>track $index</code> cho danh sách có xoá</strong> — state lệch dòng.</li>\n<li><strong>Mỗi lần nạp dữ liệu tạo FormArray mới gán vào field</strong> — template và subscriber vẫn giữ mảng cũ.</li>\n<li><strong>Giới hạn số dòng chỉ bằng disable nút</strong> — dữ liệu nạp từ server có thể vượt; đặt validator trên mảng.</li>\n</ul>\n"},{"key":"sources","label":"Nguồn","role":"reference","answer":false,"empty":false,"html":"<ul>\n<li><a href=\"https://angular.dev/guide/forms/reactive-forms\" target=\"_blank\" rel=\"noopener noreferrer\">Angular — Reactive forms (FormArray)</a></li>\n<li><a href=\"https://angular.dev/guide/forms/signals/models\" target=\"_blank\" rel=\"noopener noreferrer\">Angular — Signal Forms models</a></li>\n</ul>\n"}]}