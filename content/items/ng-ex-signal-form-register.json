register()\" novalidate></span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">      &#x3C;label for=\"u\">Tên đăng nhập&#x3C;/label></span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">      &#x3C;input id=\"u\" [formField]=\"f.username\" aria-describedby=\"u-err\" /></span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">      @if (f.username().pending()) { &#x3C;small aria-live=\"polite\">Đang kiểm tra…&#x3C;/small> }</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">      &#x3C;app-errors id=\"u-err\" [field]=\"f.username\" /></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">      &#x3C;label for=\"pw\">Mật khẩu&#x3C;/label></span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">      &#x3C;input id=\"pw\" type=\"password\" [formField]=\"f.password\" aria-describedby=\"pw-hint pw-err\" /></span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">      &#x3C;small id=\"pw-hint\">Ít nhất 10 ký tự, gồm chữ hoa, chữ thường và số&#x3C;/small></span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">      &#x3C;app-errors id=\"pw-err\" [field]=\"f.password\" /></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">      &#x3C;label for=\"cf\">Nhập lại mật khẩu&#x3C;/label></span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">      &#x3C;input id=\"cf\" type=\"password\" [formField]=\"f.confirm\" aria-describedby=\"cf-err\" /></span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">      &#x3C;app-errors id=\"cf-err\" [field]=\"f.confirm\" /></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECB