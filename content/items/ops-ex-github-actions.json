ki-dark:#9ECBFF\">api</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">          push</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">true</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">          tags</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">ghcr.io/${{ github.repository }}/api:${{ github.sha }}</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">          cache-from</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">type=gha</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">          cache-to</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">type=gha,mode=max</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">  deploy-uat</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    needs</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">image</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    runs-on</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">ubuntu-latest</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    environment</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">uat</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">    steps</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">:</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">uses</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">actions/checkout@&#x3C;sha></span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        with</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">repository</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">bank/deploy-config</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">token</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">$</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">{{ </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">secrets.DEPLOY_CONFIG_TOKEN</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }} }   </span><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># token chỉ ghi repo cấu hình</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">      - </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">Cập nhật digest cho UAT (GitOps)</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">        run</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">|</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">          cd k8s/overlays/uat</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">          kustomize edit set image ghcr.io/${{ github.repository }}/api@${{ needs.image.outputs.digest }}</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">          git config user.name \"ci-bot\" &#x26;&#x26; git config user.email \"ci-bot@users.noreply.github.com\"</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">          git commit -am \"uat: api ${{ github.sha }}\" &#x26;&#x26; git push</span></span>\n<span class=\"line\"></span></code></pre></div>"},{"key":"real","label":"Thực tế trong dự án của tôi","role":"personal","answer":true,"empty":false,"html":"<blockquote>\n<p><strong>Ngữ cảnh</strong> dựng từ phần hạ tầng của các dự án bạn đã tham gia (vai trò chính của bạn là Angular; hạ tầng thường do team nền tảng sở hữu). <strong>Tình huống điển hình</strong> là tình huống hay gặp khi vận hành hệ thống ngân hàng, bảo hiểm do app biên soạn để luyện cách kể; số liệu là ví dụ minh hoạ. Chỉ nhận là của mình phần bạn đã thật sự làm; phần khác kể là đã tìm hiểu hoặc tái hiện trong lab.</p>\n</blockquote>\n<p><strong>Ngữ cảnh:</strong> chưa dùng GitHub Actions ở dự án công ty; interview-hub (dự án cá nhân) chưa có CI.</p>\n<ul>\n<li><strong>Đã làm:</strong> dùng bài tập này để dựng workflow cho interview-hub: cài bằng <code>npm ci</code>, kiểm tra nội dung, test, build.</li>\n<li><strong>Kết quả:</strong> khi làm xong có ví dụ thật để kể.</li>\n</ul>\n<p><strong>Tình huống điển hình:</strong> Monorepo có <code>web/</code> Angular và <code>api/</code> Spring Boot, mỗi PR chạy cả hai mất 25 phút dù chỉ sửa CSS. Bài làm dùng một job phát hiện thư mục thay đổi rồi chỉ chạy job tương ứng; cache npm và Maven; token mặc định chỉ đọc; image gắn SHA; deploy UAT qua environment có người duyệt. PR chỉ sửa frontend còn 6 phút; README ghi bảng thời gian trước/sau và giải thích vì sao không dùng <code>latest</code>.</p>\n<p><strong>Lưu ý khi kể:</strong> Khi đã tự làm bài này, gắn link repo vào CV; chưa làm thì kể là bài luyện, đừng nói đã chạy ở dự án.</p>\n"},{"key":"followup","label":"Sẽ bị hỏi tiếp","role":"next","answer":true,"empty":false,"html":"<ul>\n<li><strong>Vì sao deploy qua repo cấu hình thay vì <code>kubectl apply</code> từ CI?</strong> CI không cần quyền vào cluster; Git ghi lại phiên bản đang chạy; Argo CD phát hiện và sửa lệch.</li>\n<li><strong>Token <code>DEPLOY_CONFIG_TOKEN</code> có thay bằng gì tốt hơn?</strong> GitHub App với quyền chỉ ghi một repo, token ngắn hạn sinh mỗi lần chạy — tốt hơn PAT dài hạn của một người.</li>\n<li><strong>Testcontainers trên runner GitHub-hosted có chạy không?</strong> Có — runner Ubuntu có Docker; runner tự quản lý cần cấu hình Docker hoặc Testcontainers Cloud.</li>\n</ul>\n"},{"key":"traps","label":"Bẫy thường gặp","role":"caution","answer":true,"empty":false,"html":"<ul>\n<li><strong>Đặt job có điều kiện làm required check</strong> — PR kẹt hoặc lọt khi job bị bỏ qua.</li>\n<li><strong><code>permissions: write-all</code> mặc định</strong> — token mỗi job có quyền thừa.</li>\n<li><strong>Tag image <code>latest</code></strong> — không biết UAT đang chạy commit nào.</li>\n</ul>\n"},{"key":"sources","label":"Nguồn","role":"reference","answer":false,"empty":false,"html":"<ul>\n<li><a href=\"https://docs.github.com/en/actions/security-for-github-actions/security-guides/security-hardening-for-github-actions\" target=\"_blank\" rel=\"noopener noreferrer\">GitHub — Security hardening for GitHub Actions</a></li>\n<li><a href=\"https://docs.github.com/en/actions/writing-workflows/choosing-what-your-workflow-does/control-the-concurrency-of-workflows-and-jobs\" target=\"_blank\" rel=\"noopener noreferrer\">GitHub Actions — Control the concurrency of workflows and jobs</a></li>\n</ul>\n"}]}