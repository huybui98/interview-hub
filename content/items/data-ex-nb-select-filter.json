-shiki-dark:#F97583\">FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> customers</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> city </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">IN</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Hà Nội'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'Đà Nẵng'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">ORDER BY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> full_name, id;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 4. Email Gmail, không phân biệt hoa thường → 4 dòng</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> id, email </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> customers </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> email ILIKE </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'%@gmail.com'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 5. VND, số dư 1–50 triệu → 3 dòng (15tr, 50tr, 50tr)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> account_no, balance </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> accounts</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> currency </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'VND'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> AND</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> balance </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">BETWEEN</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1000000</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> AND</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 50000000</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 6. Ba tài khoản số dư cao nhất, bằng nhau thì mở trước đứng trước</span></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">--    (đơn giản hoá: so số tiền tuyệt đối, chưa quy đổi tiền tệ)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> account_no, currency, balance, opened_at </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> accounts</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">ORDER BY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> balance </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">DESC</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, opened_at, id</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">LIMIT</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 7. Không ở Hà Nội, kể cả chưa có thành phố → 5 dòng</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> id, full_name, city </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> customers</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> city </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">IS</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> DISTINCT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> FROM</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'Hà Nội'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 8. Trang 2 (3 khách/trang) của danh sách mới nhất → Dung, Cường, Bình</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> id, full_name, created_at </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> customers</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">ORDER BY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> created_at </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">DESC</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, id </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">DESC</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">LIMIT</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> OFFSET </span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">3</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 9. Các thành phố đang có khách → 4 dòng</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT DISTINCT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> city </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> customers </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> city </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">IS NOT NULL</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ORDER BY</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> city;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">-- 10. Ký tự thứ tư là 9 → 2 dòng (0109000002, 0109000005)</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">SELECT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> account_no </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> accounts </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> account_no </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">LIKE</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '___9%'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">;</span></span>\n<span class=\"line\"></span></code></pre></div>"},{"key":"real","label":"Thực tế trong dự án của tôi","role":"personal","answer":true,"empty":false,"html":"<blockquote>\n<p><strong>Ngữ cảnh</strong> dựng từ các hệ thống dữ liệu, báo cáo trong dự án bạn đã tham gia (vai trò chính của bạn là Angular). <strong>Tình huống điển hình</strong> là tình huống hay gặp với dữ liệu ngân hàng, bảo hiểm do app biên soạn để luyện cách kể; số liệu là ví dụ minh hoạ. Chưa làm trực tiếp thì kể là đã tìm hiểu hoặc luyện, đừng nhận là đã vận hành.</p>\n</blockquote>\n<p><strong>Ngữ cảnh:</strong> màn tra cứu khách hàng, hồ sơ ở các dự án ngân hàng có bộ lọc theo ngày, trạng thái, từ khoá.</p>\n<ul>\n<li><strong>Đã làm:</strong> phía Frontend dựng bộ lọc; câu <code>WHERE</code> phía backend chưa viết trực tiếp — đã luyện bằng bài này.</li>\n<li><strong>Kết quả:</strong> khi bộ lọc &quot;thiếu dòng&quot;, biết kiểm tra trước: ranh giới ngày, NULL, phân biệt hoa thường.</li>\n</ul>\n<p><strong>Tình huống điển hình:</strong> Bài tập: lọc khách chưa có email bằng <code>WHERE email = NULL</code> trả về 0 dòng dù có 230 khách thiếu email; phải viết <code>IS NULL</code>. Lọc <code>status = 'A' OR status = 'B' AND city = 'HN'</code> cho kết quả lạ vì <code>AND</code> được tính trước <code>OR</code>; thêm ngoặc hoặc dùng <code>IN</code>. Các câu còn lại: <code>BETWEEN</code> cho khoảng tiền, <code>ILIKE</code> tìm tên không phân biệt hoa thường, <code>ORDER BY</code> kèm <code>LIMIT</code> cho top 10.</p>\n"},{"key":"followup","label":"Sẽ bị hỏi tiếp","role":"next","answer":true,"empty":false,"html":"<ul>\n<li><strong>Câu 6 so số dư khác tiền tệ với nhau có đúng không?</strong> Không — phải quy đổi theo tỷ giá trước khi so; đề cố tình đơn giản hoá. Ngoài đời, hỏi lại nghiệp vụ &quot;cao nhất theo đơn vị nào&quot;.</li>\n<li><strong>Câu 4 trên bảng 10 triệu khách có nhanh không?</strong> <code>ILIKE '%…'</code> không dùng index B-tree; cần <code>pg_trgm</code> hoặc lưu thêm cột tên miền email có index — xem <a href=\"i/data-sql-text-search\">Tìm kiếm văn bản trong database — LIKE, ILIKE, biểu thức chính quy; vì sao LIKE '%abc' không dùng được index B-tree; pg_trgm, full-text search (tsvector), tiếng Việt có dấu, và khi nào cần Elasticsearch/OpenSearch</a>.</li>\n<li><strong>Câu 8 khi người dùng đang xem mà có khách mới được tạo thì sao?</strong> <code>OFFSET</code> trượt, trang 2 lặp lại một khách của trang 1; keyset pagination khắc phục — xem <a href=\"i/java-jpa-keyset-pagination\">Keyset pagination ở tầng JPA/SQL — vì sao OFFSET chậm, viết điều kiện cursor đúng, index phù hợp, và duyệt toàn bộ bảng cho batch</a>.</li>\n</ul>\n"},{"key":"traps","label":"Bẫy thường gặp","role":"caution","answer":true,"empty":false,"html":"<ul>\n<li><strong><code>BETWEEN</code> với <code>timestamptz</code></strong> — mất dữ liệu ngày cuối.</li>\n<li><strong><code>&lt;&gt;</code> với cột có NULL</strong> — mất dòng không có giá trị.</li>\n<li><strong>Sắp xếp không toàn phần khi có <code>LIMIT</code></strong> — kết quả đổi giữa các lần chạy.</li>\n</ul>\n"},{"key":"sources","label":"Nguồn","role":"reference","answer":false,"empty":false,"html":"<ul>\n<li><a href=\"https://www.postgresql.org/docs/current/functions-comparison.html\" target=\"_blank\" rel=\"noopener noreferrer\">PostgreSQL — Comparison Functions and Operators</a></li>\n<li><a href=\"https://www.postgresql.org/docs/current/functions-matching.html\" target=\"_blank\" rel=\"noopener noreferrer\">PostgreSQL — Pattern Matching</a></li>\n<li><a href=\"https://pgexercises.com/questions/basic/\" target=\"_blank\" rel=\"noopener noreferrer\">PostgreSQL Exercises — Simple SQL Queries</a></li>\n</ul>\n"}]}