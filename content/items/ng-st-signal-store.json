BeneficiaryStore2] ở route/component; hoặc signalStore({ providedIn: 'root' }, ...)</span></span>\n<span class=\"line\"></span></code></pre></div><h3>So sánh</h3>\n<table>\n<thead>\n<tr>\n<th></th>\n<th>Signal service</th>\n<th>NgRx SignalStore</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Phụ thuộc</td>\n<td>không</td>\n<td><code>@ngrx/signals</code></td>\n</tr>\n<tr>\n<td>Cấu trúc</td>\n<td>tự quy ước</td>\n<td>chuẩn hoá</td>\n</tr>\n<tr>\n<td>Collection</td>\n<td>tự viết</td>\n<td><code>withEntities</code></td>\n</tr>\n<tr>\n<td>Tái sử dụng logic</td>\n<td>kế thừa/hàm</td>\n<td><code>signalStoreFeature</code> (custom feature)</td>\n</tr>\n<tr>\n<td>Devtools</td>\n<td>Angular DevTools</td>\n<td>+ Redux DevTools qua tiện ích</td>\n</tr>\n<tr>\n<td>Đường cong học</td>\n<td>thấp</td>\n<td>trung bình</td>\n</tr>\n</tbody>\n</table>\n<h3>Custom feature — điểm mạnh nhất</h3>\n<div class=\"ih-code\" data-lang=\"ts\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> function</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> withRequestStatus</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  return</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> signalStoreFeature</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    withState</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">({ requestStatus: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'idle'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> as</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'idle'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'pending'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'fulfilled'</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> |</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">error</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> } }),</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">    withComputed</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(({ </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">requestStatus</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ({ isPending: </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">computed</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> requestStatus</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">() </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">===</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'pending'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) })),</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span></code></pre></div><p>Mọi store <code>withRequestStatus()</code> có cùng hành vi loading/lỗi — thứ signal service phải copy-paste.</p>\n"},{"key":"real","label":"Thực tế trong dự án của tôi","role":"personal","answer":true,"empty":false,"html":"<blockquote>\n<p><strong>Ngữ cảnh</strong> dựng từ dự án thật trong CV của bạn — kiểm tra lại chi tiết trước khi dùng. <strong>Tình huống điển hình</strong> là tình huống hay gặp ở dự án Angular ngân hàng, bảo hiểm do app biên soạn để luyện cách kể; số liệu trong đó là ví dụ minh hoạ. Khi phỏng vấn, chỉ nhận là của mình phần bạn đã thật sự làm; phần còn lại kể là tình huống đã tìm hiểu hoặc tái hiện.</p>\n</blockquote>\n<p><strong>Ngữ cảnh:</strong> hệ thống kế toán của công ty bảo hiểm D (công ty bảo hiểm D, Angular 20) — tôi chọn NgRx SignalStore khi thiết kế kiến trúc cho team 6 người; công ty bảo hiểm C (Angular 21) cũng dùng SignalStore. Ở ngân hàng A (Angular 16) dùng NgRx Store cổ điển và service + BehaviorSubject.</p>\n<ul>\n<li><strong>Đã làm:</strong> feature nhỏ giữ <code>signal</code> trong service; feature nhiều bước, nhiều trạng thái (tra cứu bút toán, import chứng từ ở hệ thống kế toán của công ty bảo hiểm D; báo giá gia đình ở công ty bảo hiểm C) dùng SignalStore cung cấp theo route.</li>\n<li><strong>Kết quả:</strong> so sánh được ba cách bằng code thật: NgRx Store nhiều boilerplate, signal service mỗi người một kiểu, SignalStore cân bằng.</li>\n</ul>\n<p><strong>Tình huống điển hình:</strong> Dự án mới đội 6 người, 3 người chưa quen NgRx Store cổ điển. Đội so sánh signal service tự viết với NgRx SignalStore: tự viết thì gọn nhưng mỗi người viết một kiểu; SignalStore cho khung thống nhất (state, computed, methods, hooks), có <code>rxMethod</code> cho luồng bất đồng bộ và plugin entity, ít boilerplate hơn Store cổ điển. Chọn SignalStore; người mới viết được store đầu tiên trong 2 ngày.</p>\n<p><strong>Lưu ý khi kể:</strong> Lý do thật khi chọn và số store chỉ nêu khi đúng.</p>\n"},{"key":"followup","label":"Sẽ bị hỏi tiếp","role":"next","answer":true,"empty":false,"html":"<ul>\n<li><strong><code>patchState</code> khác <code>signal.update</code> thế nào?</strong> <code>patchState</code> gộp nông một phần state (và nhận các updater như <code>setAllEntities</code>), đảm bảo bất biến; <code>update</code> tự viết toàn bộ.</li>\n<li><strong><code>rxMethod</code> dùng khi nào?</strong> Khi method nhận giá trị theo thời gian (signal hoặc Observable) và cần operator như <code>debounceTime</code>, <code>switchMap</code> — ví dụ <code>search(query)</code> gọi với signal query.</li>\n<li><strong>SignalStore có thay được NgRx Store toàn cục không?</strong> Có thể cho nhiều app; Store vẫn hợp khi cần mô hình action/reducer toàn cục với nhiều feature cùng phản ứng một sự kiện.</li>\n</ul>\n"},{"key":"traps","label":"Bẫy thường gặp","role":"caution","answer":true,"empty":false,"html":"<ul>\n<li><strong>Lộ <code>state</code> signal ghi được ra ngoài</strong> — phá đóng gói ở cả hai cách.</li>\n<li><strong>Một SignalStore root khổng lồ cho cả app</strong> — lặp lại sai lầm của store toàn cục; chia theo feature.</li>\n<li><strong><code>catchError</code> ngoài nhánh trong <code>rxMethod</code></strong> — method chết sau lỗi đầu.</li>\n</ul>\n"},{"key":"sources","label":"Nguồn","role":"reference","answer":false,"empty":false,"html":"<ul>\n<li><a href=\"https://ngrx.io/guide/signals/signal-store\" target=\"_blank\" rel=\"noopener noreferrer\">NgRx — SignalStore</a></li>\n<li><a href=\"https://angular.dev/guide/signals\" target=\"_blank\" rel=\"noopener noreferrer\">Angular — Signals</a></li>\n</ul>\n"}]}