ark:#9ECBFF\">}</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> &#x26;&#x26; </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">git</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> log</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --oneline</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> rescue</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -3</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># Bài 4: bisect run</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">git</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> switch</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -c</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> bisect-lab</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> main</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">for</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> i </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">in</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> $(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">seq</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 1</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 30</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">); </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">do</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  if</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [ </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">$i</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> -eq</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> 20</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> ]; </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">then</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> echo</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"rate=0.02\"</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ></span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> rate.conf</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">else</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> echo</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"c</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">$i</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> >></span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> log.txt</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">; </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">fi</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  [ </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">-f</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> rate.conf ] </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">||</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> echo</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"rate=0.01\"</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ></span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> rate.conf</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  git</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> add</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -A</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> &#x26;&#x26; </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">git</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> commit</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -qm</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"commit </span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">$i</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">done</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">cat</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ></span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> /tmp/check-rate.sh</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x3C;&#x3C;</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'EOF'</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">#!/bin/sh</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">grep -q \"rate=0.01\" rate.conf          # 0 = tốt, 1 = xấu</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">EOF</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">chmod</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> +x</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> /tmp/check-rate.sh</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">git</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> bisect</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> start</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> HEAD</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> HEAD~29</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">          # xấu = HEAD, tốt = commit 1</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">git</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> bisect</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> run</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> /tmp/check-rate.sh</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">      # -> \"&#x3C;sha> is the first bad commit\" ... commit 20</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">git</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> bisect</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> reset</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># Bài 5: hook commit-msg</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">cat</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ></span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> .git/hooks/commit-msg</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> &#x3C;&#x3C;</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'EOF'</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">#!/bin/sh</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">if ! head -1 \"$1\" | grep -Eq '^(feat|fix|refactor|docs|test|chore|style|perf|build|ci)(\\([a-z0-9-]+\\))?!?: .+'; then</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  echo \"✘ Message phải theo Conventional Commits, ví dụ: fix(fee): làm tròn phí\" >&#x26;2</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">  exit 1</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">fi</span></span>\n<span class=\"line\"><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">EOF</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">chmod</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> +x</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> .git/hooks/commit-msg</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">git</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> commit</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --allow-empty</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -m</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"sửa linh tinh\"</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">        # bị từ chối</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">git</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> commit</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --allow-empty</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -m</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"chore: thử hook\"</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">      # được chấp nhận</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># Bài 6: lần từ commit xuống nội dung file</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">git</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> cat-file</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -p</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> HEAD</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">                   # dòng \"tree &#x3C;hash>\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">git</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> ls-tree</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> HEAD</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">                       # 100644 blob &#x3C;hash>  fee.txt</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">git</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> cat-file</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -p</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"$(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">git</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> rev-parse HEAD:fee.txt)\"</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">    # nội dung fee.txt</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">git</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> cat-file</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -t</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> \"$(</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">git</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> rev-parse HEAD^{tree})\"</span><span style=\"color:#6A737D;--shiki-dark:#6A737D\">     # tree</span></span>\n<span class=\"line\"></span></code></pre></div>"},{"key":"real","label":"Thực tế trong dự án của tôi","role":"personal","answer":true,"empty":false,"html":"<blockquote>\n<p><strong>Ngữ cảnh</strong> dựng từ phần hạ tầng của các dự án bạn đã tham gia (vai trò chính của bạn là Angular; hạ tầng thường do team nền tảng sở hữu). <strong>Tình huống điển hình</strong> là tình huống hay gặp khi vận hành hệ thống ngân hàng, bảo hiểm do app biên soạn để luyện cách kể; số liệu là ví dụ minh hoạ. Chỉ nhận là của mình phần bạn đã thật sự làm; phần khác kể là đã tìm hiểu hoặc tái hiện trong lab.</p>\n</blockquote>\n<p><strong>Ngữ cảnh:</strong> bài luyện tập cá nhân để củng cố các thao tác dùng hằng ngày ở ngân hàng A (cherry-pick bản sửa giữa các nhánh đợt build, merge nhánh tích hợp).</p>\n<ul>\n<li><strong>Đã làm:</strong> chạy đủ 6 bài trên máy cá nhân, ghi lại lệnh và kết quả.</li>\n<li><strong>Kết quả:</strong> tự tin dùng <code>rebase -i</code>, <code>reflog</code>, <code>bisect</code> trên repo thật.</li>\n</ul>\n<p><strong>Tình huống điển hình:</strong> Một lập trình viên lỡ <code>reset --hard</code> mất 3 commit chưa push đúng ngày chốt bản UAT và định làm lại từ đầu. Nhờ đã luyện bài cứu commit, họ mở <code>git reflog</code>, thấy commit trước khi reset, tạo nhánh tại đó và cherry-pick về — mất 5 phút. Cùng tuần đó, <code>git bisect run</code> với một script test tìm ra commit gây lỗi tính phí trong 7 bước giữa 120 commit thay vì đọc từng diff.</p>\n<p><strong>Lưu ý khi kể:</strong> Khi kể bài luyện, nói đúng là luyện trên máy cá nhân; thời gian làm từng bài thì ghi theo lần bạn tự làm.</p>\n"},{"key":"followup","label":"Sẽ bị hỏi tiếp","role":"next","answer":true,"empty":false,"html":"<ul>\n<li><strong>Bisect trên lịch sử có merge commit thì sao?</strong> Vẫn chạy; thêm <code>--first-parent</code> để chỉ đi theo dòng chính, mỗi bước là một PR.</li>\n<li><strong>Hook trong bài 5 chia sẻ cho đội thế nào?</strong> Đưa vào repo qua Husky hoặc pre-commit framework, và kiểm lại trong CI; xem <a href=\"i/ops-git-hooks\">Git hooks — pre-commit, commit-msg, pre-push; Husky + lint-staged + commitlint cho dự án Angular, pre-commit framework, quét secret; vì sao hook phía máy dev không phải là cổng chặn thật</a>.</li>\n<li><strong>Vì sao bài 3 không cứu được thay đổi chưa commit?</strong> Thay đổi chưa vào index hay commit thì Git chưa lưu, reflog không có gì để trỏ tới.</li>\n</ul>\n"},{"key":"traps","label":"Bẫy thường gặp","role":"caution","answer":true,"empty":false,"html":"<ul>\n<li><strong>Luyện trên repo công ty</strong> — một lần force push nhầm là sự cố thật; dùng thư mục tạm.</li>\n<li><strong>Script bisect không xác định</strong> (phụ thuộc mạng, thời gian) — bisect cho kết quả sai.</li>\n<li><strong>Quên <code>git bisect reset</code></strong> — repo kẹt ở detached HEAD giữa lịch sử.</li>\n</ul>\n"},{"key":"sources","label":"Nguồn","role":"reference","answer":false,"empty":false,"html":"<ul>\n<li><a href=\"https://learngitbranching.js.org/\" target=\"_blank\" rel=\"noopener noreferrer\">Learn Git Branching</a></li>\n<li><a href=\"https://git-scm.com/docs/git-bisect\" target=\"_blank\" rel=\"noopener noreferrer\">Git — git-bisect</a></li>\n<li><a href=\"https://git-scm.com/book/en/v2/Git-Internals-Git-Objects\" target=\"_blank\" rel=\"noopener noreferrer\">Pro Git — Git Objects</a></li>\n</ul>\n"}]}