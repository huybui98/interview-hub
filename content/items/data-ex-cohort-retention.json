<span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> cohort_month</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> customer</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  WHERE</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> onboarded_at </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">>=</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> TIMESTAMPTZ</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> '2026-01-01 00:00+07'</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">), activity </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  SELECT DISTINCT</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> customer_id,</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">         date_trunc(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'month'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, created_at </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">AT</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> TIME</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> ZONE</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> 'Asia/Ho_Chi_Minh'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">)::</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">date</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> AS</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> active_month</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">  FROM</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> txn</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F9758