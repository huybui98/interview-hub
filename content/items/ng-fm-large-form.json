or:#24292E;--shiki-dark:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">  });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">}</span></span>\n<span class=\"line\"></span></code></pre></div><div class=\"ih-code\" data-lang=\"html\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">@if (form.controls.vehicle.enabled) { &#x3C;</span><span style=\"color:#22863A;--shiki-dark:#85E89D\">app-vehicle-section</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> [group]</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">=</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">\"form.controls.vehicle\"</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> /> }</span></span>\n<span class=\"line\"></span></code></pre></div><p>Disable có ba lợi ích: validator ngừng chạy, <code>form.valid</code> không bị section ẩn làm sai, <code>value</code> không chứa dữ liệu thừa.</p>\n<h3>Signal Forms</h3>\n<div class=\"ih-code\" data-lang=\"ts\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">readonly f </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> form</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\">this</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">.model, (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">p</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  hidden</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(p.vehicle, { </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">when</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: ({ </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">valueOf</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> !</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">valueOf</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(p.applicant.hasVehicle) });</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">  applyWhen</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(p.vehicle, ({ </span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">valueOf</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> }) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> valueOf</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(p.applicant.hasVehicle), (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">v</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> { </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">required</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(v.plate); });</span></span>\n<span class=\"line\"><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">});</span></span>\n<span class=\"line\"></span></code></pre></div><h3>Hiệu năng</h3>\n<table>\n<thead>\n<tr>\n<th>Vấn đề</th>\n<th>Giải pháp</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Gõ một ký tự làm cả form tính lại</td>\n<td>OnPush theo section; <code>updateOn: 'blur'</code> cho field validate nặng</td>\n</tr>\n<tr>\n<td>Nạp dữ liệu 100 field bắn 100 sự kiện</td>\n<td><code>patchValue(data, { emitEvent: false })</code> rồi <code>updateValueAndValidity()</code></td>\n</tr>\n<tr>\n<td>Section dài dưới màn hình</td>\n<td><code>@defer (on viewport)</code></td>\n</tr>\n<tr>\n<td>Danh sách người phụ thuộc lớn</td>\n<td><code>track</code> theo control, virtual scroll nếu &gt; 50</td>\n</tr>\n</tbody>\n</table>\n<h3>Bảo trì</h3>\n<ul>\n<li>Kiểu dữ liệu form khớp DTO: sinh từ OpenAPI.</li>\n<li>Test quy tắc hiện/ẩn bằng unit test thuần trên <code>RULES</code>.</li>\n<li>Lỗi theo section hiển thị ở tóm tắt đầu trang để người dùng biết section nào chưa xong.</li>\n</ul>\n"},{"key":"real","label":"Thực tế trong dự án của tôi","role":"personal","answer":true,"empty":false,"html":"<blockquote>\n<p><strong>Ngữ cảnh</strong> dựng từ dự án thật trong CV của bạn — kiểm tra lại chi tiết trước khi dùng. <strong>Tình huống điển hình</strong> là tình huống hay gặp ở dự án Angular ngân hàng, bảo hiểm do app biên soạn để luyện cách kể; số liệu trong đó là ví dụ minh hoạ. Khi phỏng vấn, chỉ nhận là của mình phần bạn đã thật sự làm; phần còn lại kể là tình huống đã tìm hiểu hoặc tái hiện.</p>\n</blockquote>\n<p><strong>Ngữ cảnh:</strong> ngân hàng A — form định giá tài sản có nhiều section, nhiều field điều kiện theo loại tài sản.</p>\n<ul>\n<li><strong>Đã làm:</strong> chia form thành component theo section, mỗi section quản <code>FormGroup</code> con; section ẩn thì <code>disable()</code> để không validate; dùng OnPush và tránh <code>valueChanges</code> toàn form.</li>\n<li><strong>Kết quả:</strong> gõ không còn giật, sửa một section không đụng section khác.</li>\n</ul>\n<p><strong>Tình huống điển hình:</strong> Form định giá 150 trường, gõ vào một ô bị trễ khoảng 200 ms vì mỗi lần thay đổi chạy lại validate toàn form và một <code>valueChanges</code> lớn tính lại mọi thứ. Đội chia form thành component theo section, mỗi section quản <code>FormGroup</code> con và dùng OnPush; section ẩn bị <code>disable()</code> để không validate; tính toán chỉ lắng nghe đúng field liên quan. Độ trễ khi gõ còn dưới 30 ms.</p>\n<p><strong>Lưu ý khi kể:</strong> Số field và thời gian phản hồi trước, sau chỉ nêu khi bạn đã đo.</p>\n"},{"key":"followup","label":"Sẽ bị hỏi tiếp","role":"next","answer":true,"empty":false,"html":"<ul>\n<li><strong>Vì sao không dùng <code>@if</code> một mình để ẩn section?</strong> <code>@if</code> chỉ không render; control trong form vẫn còn và validator vẫn chạy — form không bao giờ hợp lệ vì field bắt buộc của section ẩn đang trống.</li>\n<li><strong>Dữ liệu section ẩn có nên xoá không?</strong> Tuỳ nghiệp vụ: disable giữ giá trị (người dùng bật lại thì thấy dữ liệu cũ) nhưng không gửi lên; nếu nghiệp vụ yêu cầu xoá thì <code>reset()</code> nhóm khi ẩn.</li>\n<li><strong>Lưu nháp form lớn thế nào?</strong> Debounce <code>valueChanges</code> 2–3 giây, lưu <code>getRawValue()</code> lên server hoặc IndexedDB, kèm version của form.</li>\n</ul>\n"},{"key":"traps","label":"Bẫy thường gặp","role":"caution","answer":true,"empty":false,"html":"<ul>\n<li><strong>Mỗi field một <code>valueChanges.subscribe</code> để ẩn/hiện field khác</strong> — logic phân tán, vòng lặp sự kiện.</li>\n<li><strong>Một component 2.000 dòng chứa cả form</strong> — không ai dám sửa.</li>\n<li><strong>Ẩn bằng CSS mà không disable</strong> — form không hợp lệ vì field ẩn.</li>\n</ul>\n"},{"key":"sources","label":"Nguồn","role":"reference","answer":false,"empty":false,"html":"<ul>\n<li><a href=\"https://angular.dev/guide/forms/reactive-forms\" target=\"_blank\" rel=\"noopener noreferrer\">Angular — Reactive forms</a></li>\n<li><a href=\"https://angular.dev/guide/forms/signals/form-logic\" target=\"_blank\" rel=\"noopener noreferrer\">Angular — Signal Forms form logic</a></li>\n</ul>\n"}]}