\"color:#032F62;--shiki-dark:#9ECBFF\"> docker-image</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> transfer:1.0.0</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --name</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> lab</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">kubectl</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> create</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> namespace</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> payments</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> &#x26;&#x26; </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">kubectl</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> config</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> set-context</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --current</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --namespace=payments</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">kubectl</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> create</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> configmap</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> transfer-config</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --from-literal=SPRING_PROFILES_ACTIVE=lab</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">kubectl</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> create</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> secret</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> generic</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> transfer-db</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> --from-literal=password=lab-only-secret</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">kubectl</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> apply</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> -f</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> deploy.yaml</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> &#x26;&#x26; </span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">kubectl</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> rollout</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> status</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\"> deploy/transfer</span></span>\n<span class=\"line\"></span></code></pre></div><div class=\"ih-code\" data-lang=\"yaml\"><pre class=\"shiki shiki-themes github-light github-dark\" style=\"background-color:#fff;--shiki-dark-bg:#24292e;color:#24292e;--shiki-dark:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\"># deploy.yaml</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">apiVersion</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">apps/v1</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">kind</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">Deployment</span></span>\n<span class=\"line\"><span style=\"color:#22863A;--shiki-dark:#85E89D\">metadata</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">name</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">transfer</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">labels</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: { </span><span style=\"color:#22863A;--shiki-dark:#85E89D\">app</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">: </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">transfer</span><span style