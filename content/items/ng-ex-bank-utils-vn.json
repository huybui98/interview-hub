lor:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">đ</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">g</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'d'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">replace</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#032F62;--shiki-dark:#DBEDFF\">Đ</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">/</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">g</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">, </span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'D'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">).</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">toLowerCase</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">const</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> viCollator</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> new</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> Intl.</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">Collator</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(</span><span style=\"color:#032F62;--shiki-dark:#9ECBFF\">'vi'</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49;--shiki-dark:#F97583\">export</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> const</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\"> sortVi</span><span style=\"color:#D73A49;--shiki-dark:#F97583\"> =</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> (</span><span style=\"color:#E36209;--shiki-dark:#FFAB70\">names</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">:</span><span style=\"color:#005CC5;--shiki-dark:#79B8FF\"> string</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">[]) </span><span style=\"color:#D73A49;--shiki-dark:#F97583\">=></span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\"> [</span><span style=\"color:#D73A49;--shiki-dark:#F97583\">...</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">names].</span><span style=\"color:#6F42C1;--shiki-dark:#B392F0\">sort</span><span style=\"color:#24292E;--shiki-dark:#E1E4E8\">(viCollator.compare);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D;--shiki-dark:#6A737D\">// fold('Nguyễn Đức') === 'nguyen duc'; isValidLuhn('4111 1111 1111 1111') === true</span></span>\n<span class=\"line\"></span></code></pre></div>"},{"key":"real","label":"Thực tế trong dự án của tôi","role":"personal","answer":true,"empty":false,"html":"<blockquote>\n<p><strong>Ngữ cảnh</strong> dựng từ dự án thật trong CV của bạn — kiểm tra lại chi tiết trước khi dùng. <strong>Tình huống điển hình</strong> là tình huống hay gặp ở dự án Angular ngân hàng, bảo hiểm do app biên soạn để luyện cách kể; số liệu trong đó là ví dụ minh hoạ. Khi phỏng vấn, chỉ nhận là của mình phần bạn đã thật sự làm; phần còn lại kể là tình huống đã tìm hiểu hoặc tái hiện.</p>\n</blockquote>\n<p><strong>Ngữ cảnh:</strong> dự án tra soát của ngân hàng A có ô nhập tiền dùng chung, directive chỉ nhập số, thư mục validator và dialog tra cứu CIF; app doanh nghiệp của ngân hàng B có multi-select tìm kiếm.</p>\n<ul>\n<li><strong>Đã làm:</strong> viết và sửa các validator, directive nhập số (commit &quot;fix number only&quot;), ô tiền tệ.</li>\n<li><strong>Kết quả:</strong> bài tập gần với code đã viết thật, chỉ khác là gom lại thành bộ hàm có test.</li>\n</ul>\n<p><strong>Tình huống điển hình:</strong> Bài tập: gom các hàm tiện ích hay dùng. Bản đầu định dạng VND bằng nối chuỗi tự viết, sai với số âm; tìm kiếm Nguyễn không khớp khi gõ nguyen. Bản sửa: định dạng bằng <code>Intl.NumberFormat('vi-VN')</code>, che số tài khoản giữ 4 số cuối, kiểm tra số thẻ bằng Luhn, CCCD 12 số, tìm kiếm không dấu bằng <code>normalize('NFD')</code> bỏ dấu và xử lý riêng chữ đ. Test theo bảng giá trị mẫu.</p>\n<p><strong>Lưu ý khi kể:</strong> Dự án nào có tìm kiếm không dấu và dùng thư viện hay tự viết chỉ nêu khi đúng.</p>\n"},{"key":"followup","label":"Sẽ bị hỏi tiếp","role":"next","answer":true,"empty":false,"html":"<ul>\n<li><strong>Tìm kiếm không dấu trên 50.000 khách thì sao?</strong> Tìm ở server; client chỉ gửi chuỗi đã debounce.</li>\n<li><strong>Vì sao tạo <code>Intl.NumberFormat</code> một lần?</strong> Khởi tạo formatter tốn chi phí; gọi trong template mỗi vòng change detection rất chậm — dùng pipe hoặc biến dùng chung.</li>\n<li><strong>Regex số điện thoại có đủ để xác minh chính chủ?</strong> Không; chỉ là định dạng, chính chủ cần OTP và đối chiếu nhà mạng.</li>\n</ul>\n"},{"key":"traps","label":"Bẫy thường gặp","role":"caution","answer":true,"empty":false,"html":"<ul>\n<li><strong>Nói Luhn chứng minh thẻ hợp lệ</strong> — chỉ bắt lỗi gõ.</li>\n<li><strong>Dùng <code>sort()</code> mặc định cho tên tiếng Việt</strong> — thứ tự sai.</li>\n<li><strong>Quên <code>đ/Đ</code> khi bỏ dấu</strong> — 'Đức' không tìm được bằng 'duc'.</li>\n</ul>\n"},{"key":"sources","label":"Nguồn","role":"reference","answer":false,"empty":false,"html":"<ul>\n<li><a href=\"https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Intl/Collator\" target=\"_blank\" rel=\"noopener noreferrer\">MDN — Intl.Collator</a></li>\n<li><a href=\"https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/String/normalize\" target=\"_blank\" rel=\"noopener noreferrer\">MDN — String.prototype.normalize</a></li>\n<li><a href=\"https://en.wikipedia.org/wiki/Luhn_algorithm\" target=\"_blank\" rel=\"noopener noreferrer\">Wikipedia — Luhn algorithm</a></li>\n</ul>\n"}]}